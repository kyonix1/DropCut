let AC=null,mst=null;
function audio(){ if(!AC){ try{ AC=new (window.AudioContext||window.webkitAudioContext)();
    mst=AC.createGain(); mst.gain.value=.4; mst.connect(AC.destination);}catch(e){} }
  if(AC&&AC.state==='suspended')AC.resume(); return AC; }
/* ---- three-state audio setting ----------------------------------------
   'all'    every sound
   'quiet'  taps and bell deliveries muted, everything else plays
   'off'    nothing at all
   S.muted stays a boolean for the save file: true only for full 'off'.  */
function sndMode(){ return S.snd||'all'; }
function isQuiet(){ return sndMode()!=='all'; }
function tone(f,dur,type,vol,when,slide){
  if(sndMode()==='off'||CG.sdkMute||!audio())return;
  const t0=AC.currentTime+(when||0),o=AC.createOscillator(),g=AC.createGain();
  o.type=type||'sine'; o.frequency.setValueAtTime(f,t0);
  if(slide)o.frequency.exponentialRampToValueAtTime(slide,t0+dur);
  g.gain.setValueAtTime(0,t0); g.gain.linearRampToValueAtTime(vol||.07,t0+.012);
  g.gain.exponentialRampToValueAtTime(.0001,t0+dur);
  o.connect(g); g.connect(mst); o.start(t0); o.stop(t0+dur+.05); }
/* quietTone sounds only play in "All sounds" mode — they fire constantly,
   which is exactly what a "no collect sounds" option should silence.      */
