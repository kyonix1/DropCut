<script>
'use strict';
/* =========================================================================================
   DEEPGLOW — Idle Dive Rig
   ========================================================================================= */
/* =========================================================================================
   CRAZYGAMES SDK v3 LAYER
   Everything is guarded: the game is fully playable with no SDK, on a disabled
   environment, or when the SDK script fails to load.
   Docs followed: sdk/intro, sdk/game, sdk/data, sdk/video-ads,
                  requirements/ads, requirements/technical, resources/monetizing-clicker
   ========================================================================================= */
/* ---- Sitelock (soft) ----------------------------------------------------
   Blocks the game only on clearly foreign hosts. Everything CrazyGames can
   serve from stays allowed: crazygames.* regional domains, games./app.
   subdomains, the capacitor:// origin of the iOS app, the preview tool,
   localhost/127.0.0.1 and file://. If we cannot tell, we allow — a false
   positive would show players a blank screen, which is far worse than a
   copied build.                                                            */
/* Sitelock is ENABLED for release. The game only runs on CrazyGames domains
   and the listed local/dev origins. Set to false to test on any host. */
const SITELOCK=true;
function hostAllowed(){
  if(!SITELOCK)return true;
  try{
    const h=(location.hostname||'').toLowerCase();
    if(!h||location.protocol==='file:')return true;
    if(h==='localhost'||h==='127.0.0.1'||h.endsWith('.localhost'))return true;
    if(location.protocol==='capacitor:')return true;
    const p=h.split('.'), i=p.indexOf('crazygames');
    if(i!==-1&&i>=p.length-3)return true;
    if(h.endsWith('game-files.crazygames.com'))return true;
    return false;
  }catch(e){ return true; }
}
if(!hostAllowed()){
  document.documentElement.innerHTML='<body style="margin:0;height:100vh;display:flex;'
    +'align-items:center;justify-content:center;background:#02050c;color:#8ea2c2;'
    +'font:700 16px system-ui,sans-serif;letter-spacing:.06em">'
    +'DEEPGLOW is available only on CrazyGames.</body>';
  throw new Error('sitelock');
}

/* ---- browser default fixes (CrazyGames common fixes) ---- */
// no context menu anywhere — right-clicking the canvas or UI must not open one
document.addEventListener('contextmenu',e=>e.preventDefault());
// never let the page itself scroll or the spacebar jump the document
addEventListener('keydown',e=>{
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','PageUp','PageDown','Home','End',' ','Spacebar'].includes(e.key))
    e.preventDefault();
},{passive:false});
// block page-level wheel scrolling outside the scrollable upgrade list
addEventListener('wheel',e=>{ if(!e.target.closest||!e.target.closest('#list'))e.preventDefault(); },{passive:false});
// dragging the game must never start a native image/text drag
document.addEventListener('dragstart',e=>e.preventDefault());

/* CrazyGames offers no API to check ad inventory without requesting an ad.
   This switch controls whether this build may offer ads at all.

   FALSE  = Basic Launch / QA review. Ads are disabled by the platform, so
            every ad icon, fish ad option and welcome-back ad offer is hidden.
            QA rejects builds that show rewarded buttons with no effect.
   TRUE   = Full Launch, only after CrazyGames has enabled ads for the game. */
const ADS_ENABLED=false;

const CG={
  ok:false,            // SDK initialised and usable
  env:'disabled',      // 'local' | 'crazygames' | 'disabled'
  data:null,           // data module (localStorage-compatible API)
  adblock:false,       // adblocker detected
  adsDisabled:false,   // e.g. Basic Launch — ads will never fill
  sdkMute:false,       // platform muteAudio setting (takes priority over in-game toggle)
  gameplayOn:false,

  // wait briefly for the async SDK script; never longer than `ms`
  async _await(ms){
    const t0=Date.now();
    while(!(window.CrazyGames&&window.CrazyGames.SDK)){
      if(Date.now()-t0>ms)return null;
      await new Promise(r=>setTimeout(r,60));
    }
    return window.CrazyGames.SDK;
  },
  async init(){
    const S3=await this._await(3000);
    if(!S3)return;                                    // script blocked / offline
    try{
      await S3.init();                                // v3 requires manual init
      this.env=S3.environment||'disabled';
      if(this.env==='disabled')return;                // never call a disabled SDK
      this.ok=true;
      this.data=S3.data||null;                        // Progress Save via Data Module
      // loadingStart() was requested before the async SDK existed. Start the
      // measurable SDK/data phase now; boot() will pair it with loadingStop().
      if(S3.game&&S3.game.loadingStart)try{S3.game.loadingStart();}catch(e){}
      // platform audio setting + live listener
      const apply=s=>{ this.sdkMute=!!(s&&s.muteAudio); applyMute(); };
      apply(S3.game&&S3.game.settings);
      if(S3.game&&S3.game.addSettingsChangeListener)S3.game.addSettingsChangeListener(apply);
      // adblock detection — we never block play, we only hide ad offers
      if(S3.ad&&S3.ad.hasAdblock){ try{ this.adblock=await S3.ad.hasAdblock(); }catch(e){} }
      // account + device info (all optional, never blocks play)
      this.listenAuth();
      this.loadSystem();
      await this.loadUser();
      // The scene may already be playable because SDK init is intentionally
      // non-blocking. Report that state now instead of losing the first event.
      if(this.gameplayOn&&S3.game&&S3.game.gameplayStart)
        try{S3.game.gameplayStart();}catch(e){}
    }catch(e){ this.ok=false; }
  },
  _g(){ return this.ok&&window.CrazyGames.SDK.game; },
  loadingStart(){ const g=this._g(); if(g&&g.loadingStart)try{g.loadingStart();}catch(e){} },
  loadingStop(){ const g=this._g(); if(g&&g.loadingStop)try{g.loadingStop();}catch(e){} },
  // gameplayStart: player enters a playable state / resumes. Never on menus.
  gameplayStart(){ const g=this._g(); if(this.gameplayOn)return; this.gameplayOn=true;
    if(g&&g.gameplayStart)try{g.gameplayStart();}catch(e){} },
  // gameplayStop: pause, ad, prestige break. Not on focus loss (platform handles that).
  gameplayStop(){ const g=this._g(); if(!this.gameplayOn)return; this.gameplayOn=false;
    if(g&&g.gameplayStop)try{g.gameplayStop();}catch(e){} },
  happytime(){ const g=this._g(); if(g&&g.happytime)try{g.happytime();}catch(e){} },
  completed(p){ const g=this._g(); if(g&&g.reportGameCompletedPercentage)
    try{g.reportGameCompletedPercentage(clamp(Math.round(p),0,100));}catch(e){} },
  context(o){ const g=this._g(); if(g&&g.setGameContext)try{g.setGameContext(o);}catch(e){} },
  // ads are usable only when they can actually fill
  adsUsable(){ return this.adsLive&&!this.adblock&&!this.adsDisabled; },
  adsLive:false,          // eligible to request, not a guarantee of inventory
  /* Poll every 3 s for ad ELIGIBILITY. The SDK exposes adblock state, but no
     preflight inventory/fill check. Actual availability is only known from
     requestAd(): adFinished or adError. */
  async probeAds(){
    // hard off for Basic Launch / QA: never show an ad affordance at all
    if(!ADS_ENABLED){ this.adsDisabled=true; this.adsLive=false; this.setAdsLive(false); return; }
    // no SDK at all (local file, offline, disabled env) → ads can never serve
    const ad=this.ok&&window.CrazyGames.SDK&&window.CrazyGames.SDK.ad;
    if(!ad){ this.setAdsLive(false); return; }
    if(this.adsDisabled){ this.setAdsLive(false); return; }   // Basic Launch
    let block=this.adblock;
    try{ if(ad.hasAdblock)block=await ad.hasAdblock(); }catch(e){}
    this.adblock=block;
    this.setAdsLive(!block);
  },
  /* started once from boot, independent of whether init() succeeded, so the
     state is correct in every environment and recovers by itself */
  startAdProbe(){
    if(this._probe)return;
    this.probeAds();
    if(!ADS_ENABLED)return;             // no pointless interval in QA/Basic Launch
    this._probe=setInterval(()=>this.probeAds(),3000);
  },
  _probe:null,
  setAdsLive(v){
    if(this.adsLive===v)return;
    this.adsLive=v; uiDirty=true;
    if(typeof renderPanel==='function')renderPanel();
  },

  /* ---- User module -------------------------------------------------------
     getUser / auth listener / auth prompt / system info / leaderboard score.
     All optional: the game is complete without an account.              */
  user:null,                       // {username, profilePictureUrl} or null
  device:'desktop',                // from systemInfo, used for input hints
  locale:'en',

  async loadUser(){
    const u=this._u(); if(!u||!u.isUserAccountAvailable)return;
    try{
      const usr=await u.getUser();
      this.user=(usr&&usr.username)?usr:null;
      if(usr)onUserKnown();
    }catch(e){ this.user=null; }
  },
  async loadSystem(){
    const u=this._u(); if(!u)return;
    try{
      const si=u.systemInfo;
      if(si){ this.device=(si.device&&si.device.type)||'desktop';
              this.locale=(si.locale||'en').split('-')[0]; }
    }catch(e){}
  },
  listenAuth(){
    const u=this._u(); if(!u||!u.addAuthListener)return;
    try{ u.addAuthListener(usr=>{ this.user=(usr&&usr.username)?usr:null; onUserKnown(); }); }catch(e){}
  },
  // only ever called from an explicit button, never on its own
  async signIn(){
    const u=this._u(); if(!u||!u.isUserAccountAvailable){ toast('Account saving is not available here.'); return; }
    try{ const usr=await u.showAuthPrompt();
      this.user=(usr&&usr.username)?usr:null; onUserKnown();
      toast('Signed in — your progress now syncs to your account.','gold');
    }catch(e){
      const c=e&&e.code;
      if(c==='userCancelled')toast('Sign-in cancelled.');
      else if(c==='userAlreadySignedIn')toast('You are already signed in.');
      else toast('Sign-in is not available right now.');
    }
  },

  /* ---- Leaderboard -------------------------------------------------------
     Metric: LIFETIME GLOW — the total Glow ever earned across every dive.
     It only ever grows, survives prestige, and is the single number that
     best represents overall progress in an idle game (configure the
     leaderboard as isIncremental: true, scoreSorting: DESC).
     Client-side submission needs an AES key configured in the Developer
     Portal (Leaderboards → Encryption Key). Until one is set, submission
     is skipped silently rather than erroring.                          */
  async submitScore(score){
    const u=this._u(); if(!u||!u.submitScore)return false;
    const key=LEADERBOARD_KEY;
    if(!key)return false;                       // not configured yet
    if(!this.user)return false;                 // guests are not ranked
    // the portal rejects anything above its Max Allowed Score, and an idle
    // game will eventually pass any ceiling — so clamp before sending
    let v=Math.floor(score);
    if(!isFinite(v)||v<0)return false;
    if(v>LEADERBOARD_MAX)v=LEADERBOARD_MAX;
    try{
      const enc=await this._encrypt(v,key);
      u.submitScore({ encryptedScore:enc, score:v });
      return true;
    }catch(e){ return false; }
  },
  // AES-GCM, exactly as specified in the leaderboards documentation
  async _encrypt(score,key){
    const iv=window.crypto.getRandomValues(new Uint8Array(12));
    const alg={name:'AES-GCM',iv:iv};
    const keyBytes=new Uint8Array(atob(key).split('').map(c=>c.charCodeAt(0)));
    const ck=await window.crypto.subtle.importKey('raw',keyBytes,alg,false,['encrypt']);
    const buf=await window.crypto.subtle.encrypt(alg,ck,new TextEncoder().encode(score.toString()));
    const out=new Uint8Array(iv.length+buf.byteLength);
    out.set(iv); out.set(new Uint8Array(buf),iv.length);
    return btoa(String.fromCharCode(...out));
  },
