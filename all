const ST_STYLE=[
  {w:236,h:104,r:16, hull:['#2a4359','#1d3247','#132334','#0a1622'], room:['#1a3e4c','#071420'], shape:'box'},
  {w:252,h:112,r:20, hull:['#2d4a4a','#1f3838','#14272a','#0a181c'], room:['#1c443c','#07160f'], shape:'box'},
  {w:262,h:118,r:30, hull:['#3a3358','#2a2645','#1c1a30','#0f0e1c'], room:['#33265a','#120b22'], shape:'pill'},
  {w:274,h:124,r:14, hull:['#4a3f2a','#372f1f','#241f15','#13100b'], room:['#4a3a16','#1b1408'], shape:'box'},
  {w:286,h:132,r:22, hull:['#26445e','#1b3348','#122334','#0a141f'], room:['#17415e','#07161f'], shape:'hex'},
  {w:300,h:140,r:26, hull:['#3c3560','#2b274a','#1c1932','#0f0d1d'], room:['#352a66','#120c26'], shape:'pill'},
  {w:314,h:148,r:10, hull:['#25405c','#1a2f46','#111f30','#08121d'], room:['#14385c','#06121e'], shape:'hex'},
  {w:330,h:158,r:18, hull:['#5a3a32','#412a25','#2a1b18','#150d0c'], room:['#5a2f1e','#1d0e09'], shape:'box'},
  {w:348,h:168,r:34, hull:['#5c5230','#443c23','#2c2717','#16140c'], room:['#5c4a18','#1e1808'], shape:'pill'}
];
function drawStation(i,sy){
  const d=ST[i],lv=S.lv[i],built=lv>0,hue=d.hue,t=T;
  const SS=ST_STYLE[i];
  const MW=SS.w,MH=SS.h,x=ST_X-MW/2,y=sy-MH/2;
  // docking truss: clamps the cable, bolts into the hull
  const a0=CABLE_X+6,a1=x-2;
  ctx.strokeStyle=built?'rgba(150,200,228,.45)':'rgba(120,150,180,.18)';
  ctx.lineWidth=3.5; ctx.beginPath(); ctx.moveTo(a0,sy-7); ctx.lineTo(a1,sy-7);
  ctx.moveTo(a0,sy+7); ctx.lineTo(a1,sy+7); ctx.stroke();
  ctx.lineWidth=1.2; ctx.strokeStyle=built?'rgba(150,200,228,.26)':'rgba(120,150,180,.1)';
  for(let px=a0;px<a1-12;px+=22){ ctx.beginPath(); ctx.moveTo(px,sy-7); ctx.lineTo(px+11,sy+7);
    ctx.moveTo(px+11,sy-7); ctx.lineTo(px,sy+7); ctx.stroke(); }
  ctx.fillStyle=built?'#1d3550':'#182c40'; rr(CABLE_X-7,sy-12,16,24,4); ctx.fill();
  ctx.strokeStyle=built?'rgba(175,220,248,.45)':'rgba(140,175,205,.22)'; ctx.lineWidth=1.4; rr(CABLE_X-7,sy-12,16,24,4); ctx.stroke();
  ctx.fillStyle=built?'#22405c':'#1a2c3e'; rr(x-10,sy-13,14,26,4); ctx.fill();
  ctx.strokeStyle=built?'rgba(175,220,248,.45)':'rgba(140,175,205,.2)'; ctx.lineWidth=1.4; rr(x-10,sy-13,14,26,4); ctx.stroke();
  if(built){ ctx.strokeStyle=`rgba(${hexRGB(hue)},.3)`; ctx.lineWidth=2;
    ctx.beginPath(); ctx.moveTo(a0,sy); ctx.lineTo(a1,sy); ctx.stroke();
    const fp=(t*.35)%1,fx=a1-(a1-a0)*fp;
    const fg=ctx.createRadialGradient(fx,sy,0,fx,sy,9);
    fg.addColorStop(0,`rgba(${hexRGB(hue)},.8)`); fg.addColorStop(1,`rgba(${hexRGB(hue)},0)`);
    ctx.fillStyle=fg; ctx.beginPath(); ctx.arc(fx,sy,9,0,6.283); ctx.fill(); }

  if(!built){
    ctx.setLineDash([8,7]); ctx.strokeStyle='rgba(150,190,220,.32)'; ctx.lineWidth=2;
    rr(x,y,MW,MH,SS.r); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle='rgba(120,170,210,.07)'; ctx.fill();
    ctx.textAlign='center'; ctx.fillStyle='rgba(185,218,242,.55)'; ctx.font='800 12px '+FNT;
    ctx.fillText('BUILD SITE · '+d.m+' m',ST_X,sy+4);
    ctx.font='900 13px '+FNT; ctx.fillStyle='rgba(200,230,250,.75)'; ctx.fillText(d.n.toUpperCase(),ST_X,y-14);
    return;
  }
  /* ---- every depth is a visibly different build ----------------------
     1 bare frame · 2 side pods · 3 antenna mast · 4 buttresses
     5 pressure dome · 6 rotating ring · 7 twin rings + spires
     8 energy core · 9 full monument: core, rings, spires, halo       */
  const F={ pods:i>=1, mast:i>=2, butt:i>=3, dome:i>=4, ring:i>=5,
            ring2:i>=6, core:i>=6, spire:i>=6, halo:i>=8 };

  // a faint field of light around the deepest builds
  if(F.halo){
    const hg=ctx.createRadialGradient(ST_X,sy,20,ST_X,sy,MW*.95);
    hg.addColorStop(0,`rgba(${hexRGB(hue)},.13)`); hg.addColorStop(1,`rgba(${hexRGB(hue)},0)`);
    ctx.fillStyle=hg; ctx.beginPath(); ctx.arc(ST_X,sy,MW*.95,0,6.283); ctx.fill();
  }

  ctx.strokeStyle='rgba(120,160,190,.5)'; ctx.lineWidth=4; ctx.lineCap='round';
  for(const sx of [x+40,x+MW-40]){ ctx.beginPath(); ctx.moveTo(sx,y+MH-8); ctx.lineTo(sx-14,y+MH+22); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(sx,y+MH-8); ctx.lineTo(sx+14,y+MH+22); ctx.stroke(); }
  ctx.lineCap='butt';

  // rotating containment rings, one from station 6, a second from station 7
  if(F.ring){
    ctx.save(); ctx.translate(ST_X,sy); ctx.rotate(t*.18);
    ctx.strokeStyle=`rgba(${hexRGB(hue)},.32)`; ctx.lineWidth=3;
    ctx.beginPath(); ctx.ellipse(0,0,MW*.62,MH*.82,0,0,6.283); ctx.stroke();
    for(let k=0;k<6;k++){ const a=k*1.047+t*.18;
      ctx.fillStyle=`rgba(${hexRGB(hue)},${.35+.3*Math.sin(t*2+k)})`;
      ctx.beginPath(); ctx.arc(Math.cos(a)*MW*.62,Math.sin(a)*MH*.82,3.6,0,6.283); ctx.fill(); }
    ctx.restore();
  }
  if(F.ring2){
    ctx.save(); ctx.translate(ST_X,sy); ctx.rotate(-t*.12);
    ctx.setLineDash([16,22]); ctx.lineWidth=6;
    ctx.strokeStyle=`rgba(${hexRGB(hue)},.16)`;
    ctx.beginPath(); ctx.ellipse(0,0,MW*.74,MH*.98,0,0,6.283); ctx.stroke();
    ctx.setLineDash([]); ctx.restore();
  }
  // side cargo pods from station 2
  if(F.pods){
    ctx.fillStyle='#182c3f';
    for(const k of [-1,1]){ ctx.beginPath();
      ctx.ellipse(ST_X+k*(MW/2+14),sy+18,13,22,0,0,6.283); ctx.fill();
      ctx.strokeStyle='rgba(170,220,250,.24)'; ctx.lineWidth=1.3; ctx.stroke();
      ctx.fillStyle=`rgba(${hexRGB(hue)},${.3+.25*Math.sin(t*2+k)})`;
      ctx.beginPath(); ctx.arc(ST_X+k*(MW/2+14),sy+10,2.6,0,6.283); ctx.fill();
      ctx.fillStyle='#182c3f'; }
  }
  // antenna mast from station 3
  if(F.mast){
    ctx.strokeStyle='rgba(150,200,228,.5)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.moveTo(x+30,y); ctx.lineTo(x+30,y-30); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x+22,y-24); ctx.lineTo(x+38,y-24); ctx.stroke();
    ctx.fillStyle=`rgba(255,150,120,${.4+.4*Math.sin(t*3)})`;
    ctx.beginPath(); ctx.arc(x+30,y-32,2.6,0,6.283); ctx.fill();
  }
  // heavy buttresses from station 4
  if(F.butt){
    ctx.fillStyle='#16283a';
    for(const sx of [x-9,x+MW+1]){
      for(let k=0;k<3;k++){ const by=y+16+k*((MH-32)/2);
        rr(sx,by,8,26,3); ctx.fill(); } }
    ctx.strokeStyle='rgba(170,220,250,.22)'; ctx.lineWidth=1;
    for(const sx of [x-9,x+MW+1]){
      for(let k=0;k<3;k++){ const by=y+16+k*((MH-32)/2); rr(sx,by,8,26,3); ctx.stroke(); } }
  }
  const hull=ctx.createLinearGradient(0,y,0,y+MH);
  hull.addColorStop(0,SS.hull[0]); hull.addColorStop(.18,SS.hull[1]);
  hull.addColorStop(.62,SS.hull[2]); hull.addColorStop(1,SS.hull[3]);
  ctx.fillStyle=hull; rr(x,y,MW,MH,SS.r); ctx.fill();
  ctx.strokeStyle='rgba(170,220,250,.3)'; ctx.lineWidth=2; rr(x,y,MW,MH,SS.r); ctx.stroke();
  ctx.strokeStyle='rgba(255,255,255,.1)'; ctx.lineWidth=1; rr(x+3,y+3,MW-6,MH-6,Math.max(4,SS.r-3)); ctx.stroke();
  // hex builds get angled corner plates, pill builds get a bright waistline
  if(SS.shape==='hex'){
    ctx.fillStyle='rgba(8,18,30,.75)';
    for(const sx of [x,x+MW]){ for(const syy of [y,y+MH]){
      ctx.beginPath(); ctx.moveTo(sx,syy);
      ctx.lineTo(sx+(sx===x?26:-26),syy);
      ctx.lineTo(sx,syy+(syy===y?20:-20)); ctx.closePath(); ctx.fill(); } }
  } else if(SS.shape==='pill'){
    ctx.strokeStyle=`rgba(${hexRGB(hue)},.35)`; ctx.lineWidth=3;
    ctx.beginPath(); ctx.moveTo(x+6,sy); ctx.lineTo(x+MW-6,sy); ctx.stroke();
  }
  // pressure dome from station 5
  if(F.dome){
    const dg=ctx.createLinearGradient(0,y-30,0,y);
    dg.addColorStop(0,F.core?'#2f5570':'#24415a'); dg.addColorStop(1,'#132334');
    ctx.fillStyle=dg;
    ctx.beginPath(); ctx.ellipse(ST_X,y+2,52,26,0,Math.PI,0); ctx.fill();
    ctx.strokeStyle='rgba(180,228,255,.3)'; ctx.lineWidth=1.6;
    ctx.beginPath(); ctx.ellipse(ST_X,y+2,52,26,0,Math.PI,0); ctx.stroke();
  }
  // exposed energy core from station 7
  if(F.core){
    const cg=ctx.createRadialGradient(ST_X,y-8,1,ST_X,y-8,26);
    cg.addColorStop(0,'rgba(255,255,255,.9)'); cg.addColorStop(.35,`rgba(${hexRGB(hue)},.75)`);
    cg.addColorStop(1,`rgba(${hexRGB(hue)},0)`);
    ctx.save(); ctx.globalCompositeOperation='lighter';
    ctx.fillStyle=cg; ctx.beginPath(); ctx.arc(ST_X,y-8,20+2*Math.sin(t*3),0,6.283); ctx.fill();
    ctx.restore();
  }
  // spires from station 7, a taller centre spire on station 9
  if(F.spire){
    ctx.strokeStyle=`rgba(${hexRGB(hue)},.55)`; ctx.lineWidth=2.6; ctx.lineCap='round';
    for(const k of [-1,1]){ ctx.beginPath(); ctx.moveTo(ST_X+k*44,y+2); ctx.lineTo(ST_X+k*56,y-34); ctx.stroke();
      ctx.fillStyle=`rgba(${hexRGB(hue)},${.5+.4*Math.sin(t*2.6+k)})`;
      ctx.beginPath(); ctx.arc(ST_X+k*56,y-36,3.4,0,6.283); ctx.fill(); }
    if(F.halo){ ctx.lineWidth=3;
      ctx.beginPath(); ctx.moveTo(ST_X,y-22); ctx.lineTo(ST_X,y-58); ctx.stroke();
      ctx.fillStyle=`rgba(255,255,255,${.6+.4*Math.sin(t*4)})`;
      ctx.beginPath(); ctx.arc(ST_X,y-60,4.2,0,6.283); ctx.fill(); }
    ctx.lineCap='butt';
  }
  ctx.fillStyle='#22384c'; rr(x+MW/2-38,y-11,76,14,7); ctx.fill();
  ctx.strokeStyle='rgba(170,220,250,.25)'; ctx.lineWidth=1.2; rr(x+MW/2-38,y-11,76,14,7); ctx.stroke();
  const bl=.45+.35*Math.sin(t*1.6+i);
  ctx.fillStyle=`rgba(${S.over[i]?'255,210,130':'125,255,190'},${bl})`;
  ctx.beginPath(); ctx.arc(ST_X,y-18,3.6,0,6.283); ctx.fill();
  ctx.strokeStyle='rgba(180,220,250,.35)'; ctx.lineWidth=1.6;
  ctx.beginPath(); ctx.moveTo(ST_X,y-11); ctx.lineTo(ST_X,y-18); ctx.stroke();
  ctx.fillStyle='rgba(190,225,250,.18)';
  for(let k=0;k<5;k++){ ctx.beginPath(); ctx.arc(x+12,y+24+k*21,1.7,0,6.283); ctx.fill();
    ctx.beginPath(); ctx.arc(x+MW-12,y+24+k*21,1.7,0,6.283); ctx.fill(); }

  const ix=x+24,iy=y+16,iw=MW-48,ih=MH-38;
  const wr=SS.shape==='pill'?Math.min(24,ih/2):SS.shape==='hex'?4:11;   // window shape per depth
  const room=ctx.createLinearGradient(0,iy,0,iy+ih);
  room.addColorStop(0,SS.room[0]); room.addColorStop(1,SS.room[1]);
  ctx.fillStyle=room; rr(ix,iy,iw,ih,wr); ctx.fill();
  ctx.save(); rr(ix,iy,iw,ih,wr); ctx.clip();
  for(let k=0;k<3;k++){ const lx=ix+iw*(.22+k*.28);
    ctx.fillStyle='rgba(190,235,250,.5)'; ctx.fillRect(lx-6,iy+2,12,3);
    const cone=ctx.createLinearGradient(0,iy+5,0,iy+ih);
    cone.addColorStop(0,`rgba(${hexRGB(hue)},.2)`); cone.addColorStop(1,`rgba(${hexRGB(hue)},0)`);
    ctx.fillStyle=cone; ctx.beginPath(); ctx.moveTo(lx-7,iy+5); ctx.lineTo(lx+7,iy+5);
    ctx.lineTo(lx+30,iy+ih); ctx.lineTo(lx-30,iy+ih); ctx.closePath(); ctx.fill(); }
  ctx.strokeStyle='rgba(150,205,230,.09)'; ctx.lineWidth=1;
  for(let gx=ix+14;gx<ix+iw;gx+=26){ ctx.beginPath(); ctx.moveTo(gx,iy+6); ctx.lineTo(gx,iy+ih-16); ctx.stroke(); }
  ctx.fillStyle='rgba(5,14,22,.92)'; ctx.fillRect(ix,iy+ih-15,iw,15);
  ctx.strokeStyle='rgba(150,205,230,.16)';
  for(let gx=ix;gx<ix+iw;gx+=13){ ctx.beginPath(); ctx.moveTo(gx,iy+ih-15); ctx.lineTo(gx+5,iy+ih); ctx.stroke(); }
  const fill=clamp(S.tank[i]/tankCap(i),0,1),full=fill>.985&&!uL('pipe');
  const tw=30,tx=ix+iw-tw-10,ty=iy+12,th=ih-34;
  ctx.fillStyle='rgba(4,16,24,.95)'; rr(tx,ty,tw,th,7); ctx.fill();
  // straight liquid bar that rises from the bottom — never a rounded blob
  if(fill>0){
    const iw2=tw-6, ih2=(th-6)*fill, ix2=tx+3, iy2=ty+3+(th-6)*(1-fill);
    const liq=ctx.createLinearGradient(0,iy2,0,ty+th-3);
    liq.addColorStop(0,full?'#ffb36b':hue); liq.addColorStop(1,full?'rgba(255,120,80,.65)':`rgba(${hexRGB(hue)},.55)`);
    ctx.fillStyle=liq; ctx.fillRect(ix2,iy2,iw2,ih2);
    ctx.fillStyle='rgba(255,255,255,.3)'; ctx.fillRect(ix2,iy2,iw2,1.6);
  }
  ctx.strokeStyle='rgba(190,235,255,.35)'; ctx.lineWidth=1.5; rr(tx,ty,tw,th,7); ctx.stroke();
  ctx.strokeStyle='rgba(190,235,255,.14)';
  for(let k=1;k<4;k++){ ctx.beginPath(); ctx.moveTo(tx+2,ty+th*k/4); ctx.lineTo(tx+9,ty+th*k/4); ctx.stroke(); }
  const wx=ix+26,wy=iy+ih-32,R=13;
  ctx.fillStyle='rgba(18,38,52,.95)'; ctx.beginPath(); ctx.arc(wx,wy,R+5,0,6.283); ctx.fill();
  ctx.save(); ctx.translate(wx,wy); ctx.rotate(t*(1.2+Math.min(lv,60)*.04));
  ctx.strokeStyle='rgba(175,225,245,.6)'; ctx.lineWidth=2.6; ctx.beginPath(); ctx.arc(0,0,R,0,6.283); ctx.stroke();
  for(let k=0;k<4;k++){ ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(Math.cos(k*1.5708)*R,Math.sin(k*1.5708)*R); ctx.stroke(); }
  ctx.restore();
  ctx.strokeStyle='rgba(150,200,228,.35)'; ctx.lineWidth=4;
  ctx.beginPath(); ctx.moveTo(wx+R+5,wy); ctx.lineTo(tx-5,wy); ctx.lineTo(tx-5,ty+th*.55); ctx.stroke();
  ctx.fillStyle='rgba(20,44,58,.95)'; rr(ix+iw*.44,iy+ih-30,44,15,4); ctx.fill();
  for(let k=0;k<3;k++){ ctx.fillStyle=`rgba(${hexRGB(hue)},${.35+.4*Math.abs(Math.sin(t*3+k*1.7))})`;
    ctx.fillRect(ix+iw*.44+6+k*12,iy+ih-26,7,4); }
  const crew=clamp(1+Math.floor(Math.log10(1+lv)*2.4),1,4);
  for(let c=0;c<crew;c++){
    const span=iw-130,base=ix+52;
    const px=base+((Math.sin(t*.5+c*2.3+i)+1)/2)*span,bob=Math.abs(Math.sin(t*3+c))*2,fy=iy+ih-15-bob;
    ctx.fillStyle=S.over[i]?'rgba(255,214,150,.95)':'rgba(150,205,225,.95)'; rr(px-4,fy-11,8,11,3.4); ctx.fill();
    ctx.fillStyle=S.over[i]?'#ffe9c2':'#bfe6f5'; ctx.beginPath(); ctx.arc(px,fy-15,4.4,0,6.283); ctx.fill();
    ctx.fillStyle='rgba(255,255,255,.6)'; ctx.beginPath(); ctx.arc(px+1.5,fy-15.8,1.6,0,6.283); ctx.fill();
    ctx.strokeStyle=S.over[i]?'rgba(255,214,150,.8)':'rgba(170,215,235,.8)'; ctx.lineWidth=1.7;
    ctx.beginPath(); ctx.moveTo(px-4,fy-7); ctx.lineTo(px-8,fy-4+Math.sin(t*4+c)*2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(px+4,fy-7); ctx.lineTo(px+8,fy-4-Math.sin(t*4+c)*2); ctx.stroke(); }
  ctx.restore();
  ctx.strokeStyle='rgba(185,230,252,.28)'; ctx.lineWidth=2; rr(ix,iy,iw,ih,wr); ctx.stroke();
  const sheen=ctx.createLinearGradient(ix,iy,ix+iw*.6,iy+ih);
  sheen.addColorStop(0,'rgba(255,255,255,.07)'); sheen.addColorStop(.5,'rgba(255,255,255,0)');
  ctx.fillStyle=sheen; rr(ix,iy,iw,ih,wr); ctx.fill();
  ctx.textAlign='center'; ctx.font='900 13px '+FNT; ctx.fillStyle=hue; ctx.fillText(d.n.toUpperCase(),ST_X,y-26);
  ctx.font='800 10.5px '+FNT; ctx.fillStyle='rgba(195,228,248,.6)';
  ctx.fillText(d.m+' m  ·  Lv '+lv+'  ·  '+fmt(stRate(i))+'/s',ST_X,y-14);
}

/* ship — always right of the winch, never overlapping it or the panel */
function drawShip(sy){
  const tier=S.ship,t=T,by=sy-2+Math.sin(t*.8)*3;
  const hw=[86,108,130,152][tier], hh=[26,31,36,42][tier];
  const hg=ctx.createLinearGradient(0,by-hh,0,by+6);
  hg.addColorStop(0,['#1b3352','#22415f','#2b5070','#375f80'][tier]); hg.addColorStop(1,'#0a1526');
  ctx.fillStyle=hg;
  ctx.beginPath(); ctx.moveTo(LAMP_SX-hw,by); ctx.lineTo(LAMP_SX+hw,by);
  ctx.lineTo(LAMP_SX+hw*.74,by-hh); ctx.lineTo(LAMP_SX-hw*.8,by-hh); ctx.closePath(); ctx.fill();
  ctx.strokeStyle='rgba(180,220,250,.22)'; ctx.lineWidth=1.5; ctx.stroke();
  ctx.fillStyle=['#2f6f8a','#3c8aa2','#49a3b4','#5cc0c6'][tier];
  ctx.fillRect(LAMP_SX-hw*.95,by-6,hw*1.9,3);
  const sw=[42,54,64,76][tier],sh=[24,30,37,45][tier];
  ctx.fillStyle='#16294a'; rr(LAMP_SX-sw/2+8,by-hh-sh,sw,sh,4); ctx.fill();
  ctx.strokeStyle='rgba(180,220,250,.2)'; rr(LAMP_SX-sw/2+8,by-hh-sh,sw,sh,4); ctx.stroke();
  const wn=[2,3,4,5][tier];
  for(let k=0;k<wn;k++){ ctx.fillStyle=`rgba(255,201,120,${.45+.3*Math.abs(Math.sin(t*1.1+k))})`;
    ctx.fillRect(LAMP_SX-sw/2+14+k*((sw-14)/wn),by-hh-sh+8,8,7); }
  ctx.strokeStyle='#2a4a68'; ctx.lineWidth=3;
  const mh=[18,26,32,40][tier];
  ctx.beginPath(); ctx.moveTo(LAMP_SX-sw/2+4,by-hh-sh); ctx.lineTo(LAMP_SX-sw/2+4,by-hh-sh-mh); ctx.stroke();
  const mt=by-hh-sh-mh;
  ctx.fillStyle=`rgba(255,214,120,${.65+.35*Math.sin(t*2.1)})`;
  ctx.beginPath(); ctx.arc(LAMP_SX-sw/2+4,mt-3,3.4,0,6.283); ctx.fill();
  if(tier>=2){ ctx.save(); ctx.translate(LAMP_SX-sw/2+4,mt+8); ctx.rotate(t*1.1);
    ctx.strokeStyle='rgba(180,225,250,.55)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.ellipse(0,0,11,4,0,0,6.283); ctx.stroke(); ctx.restore(); }
  if(tier>=1){ ctx.strokeStyle='#31536f'; ctx.lineWidth=4;   // deck crane, stays on the ship
    ctx.beginPath(); ctx.moveTo(LAMP_SX+hw*.55,by-hh); ctx.lineTo(LAMP_SX+hw*.55,by-hh-34);
    ctx.lineTo(LAMP_SX+hw*.28,by-hh-42); ctx.stroke(); }
  if(tier>=3){ ctx.fillStyle='#132540'; rr(LAMP_SX+hw*.2,by-hh-14,54,14,4); ctx.fill(); }
}
function drawWinch(){
  const t=T,py=WINCH_Y-camY;
  ctx.fillStyle='#1c3350'; rr(CABLE_X-38,py-6,76,12,5); ctx.fill();
  ctx.strokeStyle='rgba(175,220,248,.28)'; ctx.lineWidth=1.4; rr(CABLE_X-38,py-6,76,12,5); ctx.stroke();
  ctx.strokeStyle='#2c4a6b'; ctx.lineWidth=4; ctx.lineCap='round';
  ctx.beginPath(); ctx.moveTo(CABLE_X-22,py-6); ctx.lineTo(CABLE_X,py-40); ctx.lineTo(CABLE_X+22,py-6); ctx.stroke();
