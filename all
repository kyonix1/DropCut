function mix(a,b,f){ const pa=parseInt(a.slice(1),16),pb=parseInt(b.slice(1),16);
  return `rgb(${(((pa>>16)&255)+((((pb>>16)&255)-((pa>>16)&255))*f))|0},${(((pa>>8)&255)+((((pb>>8)&255)-((pa>>8)&255))*f))|0},${((pa&255)+(((pb&255)-(pa&255))*f))|0})`; }
