/* ---------------- number formatting (no more "1000M") ---------------- */
/* Fast, allocation-light and safe for anything a JS number can hold.
   No loops over the magnitude, no regex, no Math.pow — a single log10 and
   one table lookup. NaN and Infinity can never leak into the UI.        */
function fmt(n){
  if(typeof n!=='number'||n!==n)return '0';          // NaN guard
  if(n<0)return '-'+fmt(-n);
  if(n===Infinity)return '∞';
  if(n<1000){
    if(n<10){ const r=Math.round(n*10)/10; return ''+r; }   // JS drops trailing .0
    return ''+Math.floor(n);
  }
  let t=(Math.log10(n)/3)|0;                          // magnitude tier
  if(t<1)t=1; else if(t>102)t=102;
  let m=n/P1K[t];
  if(m>=1000){ m/=1000; t++; }                        // log10 rounding guard
  else if(m<1&&t>1){ m*=1000; t--; }
  let s;
  if(m>=100){ let r=Math.round(m); if(r>=1000){ r=1; t++; } s=''+r; }
  else if(m>=10) s=''+(Math.round(m*10)/10);
  else s=''+(Math.round(m*100)/100);
  return s+sufFor(t);
}
function fmtTime(s){ s|=0; const h=s/3600|0,m=(s%3600)/60|0,x=s%60; return h?`${h}h ${m}m`:(m?`${m}m ${x}s`:`${x}s`); }
const clamp=(v,a,b)=>v<a?a:v>b?b:v, rand=(a,b)=>a+Math.random()*(b-a);
const uL=id=>S.ups[id]|0, pL=id=>S.per[id]|0;
const LOG_SAFE=Math.log(SAFE_MAX);
function powSafe(base,exp){
  if(!(base>0)||!(exp>=0))return 0;
  const log=Math.log(base)*exp;
  return log>=LOG_SAFE?SAFE_MAX:Math.exp(log);
}
function mulSafe(...v){
  let out=1;
  for(const n of v){
    if(!(n>=0)||!Number.isFinite(n))return n===Infinity?SAFE_MAX:0;
    if(n===0)return 0;
    if(out>SAFE_MAX/n)return SAFE_MAX;
    out*=n;
  }
  return Math.min(SAFE_MAX,out);
}
function addSafe(a,b){ return a>=SAFE_MAX-b?SAFE_MAX:a+b; }

/* ---------------- depth (piecewise, matches the station plates) ---------------- */
function metresAt(wy){
  if(wy<=ANCH[0][0])return 0;
  for(let i=1;i<ANCH.length;i++){
    if(wy<=ANCH[i][0]){ const [y0,m0]=ANCH[i-1],[y1,m1]=ANCH[i];
      return Math.round(m0+(m1-m0)*(wy-y0)/(y1-y0)); } }
  const [y0,m0]=ANCH[ANCH.length-2],[y1,m1]=ANCH[ANCH.length-1];
  return Math.round(m1+(m1-m0)*(wy-y1)/(y1-y0));
}

/* ---------------- prestige: you SPEND the Glow you are holding ----------------
   Prestige trades the Glow currently in your wallet for Sunpearls. Banking more
   before you prestige is always worth it, and nothing is based on lifetime
   totals, so the reward can never drift away from what you actually have. */
const PRES_GLOW=1e6;                       // minimum wallet to prestige
function pearlsFor(glow){ return glow<PRES_GLOW?0:Math.floor(Math.min(SAFE_MAX,4*powSafe(glow/PRES_GLOW,.6))); }
function ascGain(){ return pearlsFor(S.glim); }
function glowForPearls(p){ return PRES_GLOW*Math.pow(Math.max(p,1)/4,1/.6); }

/* ---------------- economy ---------------- */
let evProd=1,evClick=1;
function totLv(){ let t=0; for(const l of S.lv)t+=l; return t; }
function shipMult(){ return 1+.3*S.ship; }
// NOTE: sunpearls themselves give nothing — only the upgrades you buy with them do.
function globalMult(events=true){ return mulSafe(1+.25*pL('all'),shipMult(),events?evProd:1); }
/* Station levels double their output at fixed milestones, and then keep
   doubling every 250 levels forever. This is the main reason a late run
   never stalls: levels stay worth buying no matter how high they go. */
const BOOST_STEP=250;
function boostMult(l){
  let m=1; for(const b of BOOSTS) if(l>=b)m*=2;
  const last=BOOSTS[BOOSTS.length-1];
  if(l>last)m=mulSafe(m,powSafe(2,Math.floor((l-last)/BOOST_STEP)));
  return Math.min(SAFE_MAX,m);
}
function nextBoost(l){
  for(const b of BOOSTS) if(l<b)return b;
  const last=BOOSTS[BOOSTS.length-1];
  return last+BOOST_STEP*(Math.floor((l-last)/BOOST_STEP)+1);
}
function stRate(i,events=true){ const l=S.lv[i]; if(!l)return 0;
  return mulSafe(ST[i].rate,l,boostMult(l),S.over[i]?3:1,powSafe(1.09,uL('boost')),abyssMult(),globalMult(events)); }
function totalRate(events=true){ let t=0; for(let i=0;i<ST.length;i++)t=addSafe(t,stRate(i,events)); return t; }
function tankCap(i){ return Math.max(60,mulSafe(stRate(i),20,powSafe(1.7,S.tankLv[i]))); }

/* lamp: the cable decides how deep you may go — every station is reachable in one run */
function maxCable(){ return ST.length-1; }
function reachY(cable){ const c=clamp(cable===undefined?S.lamp.cable:cable,0,ST.length-1); return ST[c].y+320; }
function reachedStation(i){ return S.lamp.cable>=i; }
function lightR(){ return 140+18*S.lamp.bulb+16*S.lamp.cable; }
/* ---- brightness is RELATIVE to how dark the current depth is ----
   Near the surface the water is bright anyway, so even a weak lamp lights everything.
   Deeper down the same lamp only reveals a little, and upgrades close that gap.
   Everything is capped, so the lamp can light a zone fully but never glare.       */
const L_BASE=.30, L_BULB=.030, L_CABLE=.015;
function lampRaw(b,c){                                               // raw output from upgrades
  return L_BASE+L_BULB*(b===undefined?S.lamp.bulb:b)
               +L_CABLE*(c===undefined?S.lamp.cable:c);
}
function needDark(){ return Math.max(.08,darkAt(lampY())); }         // darkness to overcome here
function lampFill(){ return clamp(lampRaw()/needDark(),0,1); }       // 1 = this depth is fully lit
function lampPow(){ return clamp(Math.min(lampRaw(),needDark()),.06,.85); } // visible glow, capped

/* ---- BRIGHTER LAMP CAP -------------------------------------------------
   Light beyond "this area is fully lit" is wasted — the darkness mask is
   already cleared, so extra levels would change nothing on screen. So the
   upgrade is capped at exactly the level that fully lights the deepest
   water your cable can currently reach. Extending the cable opens deeper,
   darker water and raises the cap again.                                */
function bulbCap(){
  const need=darkAt(reachY());                       // darkest water in range
  const n=Math.ceil((need-L_BASE-L_CABLE*S.lamp.cable)/L_BULB);
  return clamp(n,1,400);
}
function bulbMaxed(){ return S.lamp.bulb>=bulbCap(); }
function camMax(){ return clamp(reachY()-LAMP_SY+70,110,WORLD_H-H); }
function lampY(){ return camY+LAMP_SY; }

/* bell line */
/* The bell is a throttle, never a wall. A hard min() would stall the game the
   moment a deeper station is built (long trip + small hold = almost no income
   and no way to earn the upgrade that fixes it). So the throttle has a floor:
   you always keep at least BELL_FLOOR of production, and a good bell lifts
   that back up to 100% — a clear 4× reward for upgrading. */
const BELL_FLOOR=.25;
function bellSpeed(){ return mulSafe(260,powSafe(1.13,S.bell.winch)); }
function bellHold(){ return mulSafe(160,powSafe(1.6,S.bell.hold)); }
function bellN(){ return 1+S.bell.extra; }
function deepBuilt(){ let y=SEA+140; for(let i=0;i<ST.length;i++) if(S.lv[i]>0)y=Math.max(y,ST[i].y); return y; }
function trip(){ return Math.max(1.1,2*(deepBuilt()-WINCH_Y)/bellSpeed()); }
function haul(){ return uL('pipe')?Infinity:Math.min(SAFE_MAX,mulSafe(bellHold(),bellN())/trip()); }
// delivered = what the bell carries + a hand-skimmed share of the overflow
function income(events=true){ const p=totalRate(events); if(uL('pipe'))return p;
  const h=haul(); return Math.min(SAFE_MAX,Math.min(p,h)+Math.max(0,p-h)*BELL_FLOOR); }
function bellEff(){ const p=totalRate(); return p>0?income()/p:1; }

/* taps stay a small, early-game tool — never the main engine */
function tapPow(){ return mulSafe(powSafe(1.08,S.lamp.bulb),powSafe(1.22,uL('tap')),
  1+.1*pL('tapp'),powSafe(4,uL('echo')),globalMult(),evClick); }

/* costs */
function lvCost(i){ return ST[i].base*Math.pow(1.115,S.lv[i])*Math.pow(.97,pL('cheap')); }
function tankCost(i){ return ST[i].base*6*Math.pow(2.05,S.tankLv[i]); }
function overCost(i){ return ST[i].base*30; }
function offlineEff(){ return clamp(.01+.01*pL('off'),.01,.10); }

/* key:1 marks an upgrade as essential — the ones a player should buy first.
   Everything without it is optional flavour and sits below a divider. */
