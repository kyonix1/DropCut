  const hs=pL('start'); t.glim=2500*hs; t.lv[0]=5*hs; t.lamp.cable=Math.min(hs,ST.length-1);
  S=t; active.length=0; fish=null; boost=null; refreshBoostHud();
  fishTimer=120; nextEv=rand(60,120); started=false;
  bells=[]; syncBells(); camY=camTarget=0; seedCreatures(); closeModal();
