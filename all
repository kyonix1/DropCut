    border:1px solid rgba(255,255,255,.14);
    box-shadow:0 3px 0 rgba(0,0,0,.32),inset 0 1px 0 rgba(255,255,255,.14);
    transition:transform .1s,box-shadow .1s,background .14s}
  .fOpt:hover{background:linear-gradient(180deg,rgba(255,255,255,.18),rgba(255,255,255,.07));transform:translateY(-1px)}
  .fOpt:active{transform:translateY(3px);box-shadow:0 0 0 rgba(0,0,0,.32),inset 0 1px 0 rgba(255,255,255,.1)}
  .fOpt .fi{width:30px;height:30px;flex:0 0 auto;border-radius:9px;display:flex;align-items:center;justify-content:center;
    background:rgba(255,255,255,.08)}
  .fOpt .fi svg{width:17px;height:17px}
  .fOpt b{display:block;font-size:13px;font-weight:900}
  .fOpt small{display:block;font-size:11px;color:var(--dim);font-weight:700;margin-top:1px}
  .fOpt.ad{background:linear-gradient(135deg,rgba(255,207,107,.16),rgba(255,157,60,.1));border-color:rgba(255,207,107,.45)}
  .fOpt.ad b{color:#ffe3a6} .fOpt.ad .fi{background:rgba(255,207,107,.2);color:var(--gold)}
  .fOpt.adBlue{background:linear-gradient(135deg,rgba(110,190,255,.16),rgba(60,140,220,.1));border-color:rgba(130,200,255,.45)}
  .fOpt.adBlue b{color:#bfe4ff} .fOpt.adBlue .fi{background:rgba(120,190,255,.2);color:#8fd0ff}
  .fOpt.free b{color:#a9ffca} .fOpt.free .fi{background:rgba(125,255,168,.16);color:var(--good)}
  .fOpt.no b{color:#9fb0cc} .fOpt.no .fi{background:rgba(255,255,255,.06);color:#9fb0cc}

  /* ---- offline reward card: minimal, one number, two buttons ---- */
  #modalBox.bare{width:340px;padding:0;background:none;border:none;box-shadow:none}
  .offCard{padding:26px 24px 22px;border-radius:22px;text-align:center;
    background:linear-gradient(170deg,#10243f,#060f1f);
    border:1px solid rgba(95,242,214,.28);box-shadow:0 26px 70px rgba(0,0,0,.6)}
  .offTop{display:flex;align-items:center;justify-content:center;gap:7px;color:#7f9dc0}
  .offIco{width:16px;height:16px;display:block;color:var(--glow)}
  .offIco svg{width:16px;height:16px}
  .offAway{font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .offAmt{font-size:46px;font-weight:900;color:var(--glow);line-height:1.05;margin-top:12px;
    font-variant-numeric:tabular-nums;text-shadow:0 0 34px rgba(95,242,214,.4)}
  .offUnit{font-size:10.5px;font-weight:800;letter-spacing:.32em;color:#6f87a8;margin-top:3px}
  .offBtns{display:flex;flex-direction:column;gap:9px;margin-top:22px}
  .offAd{display:flex;align-items:center;justify-content:center;gap:9px;padding:15px;border-radius:15px;
    font-weight:900;color:#241a05;background:linear-gradient(180deg,#fff0c6,#ffcf6b 45%,#ef8f22);
    text-shadow:0 1px 0 rgba(255,255,255,.4);transition:transform .1s,box-shadow .1s,filter .12s;
    box-shadow:0 4px 0 #a6600f,0 9px 20px rgba(255,170,60,.34),inset 0 1px 0 rgba(255,255,255,.55)}
  .offAd:hover{filter:brightness(1.05);transform:translateY(-1px)}
  .offAd:active{transform:translateY(4px);box-shadow:0 0 0 #a6600f,inset 0 1px 0 rgba(255,255,255,.4)}
  .offAd svg{width:15px;height:15px}
  .offAd b{font-size:15px}
  .offAd i{font-style:normal;font-size:12.5px;font-weight:800;opacity:.75;font-variant-numeric:tabular-nums}
  .offGet{padding:15px;border-radius:15px;font-size:14.5px;font-weight:900;color:#dff0ff;
    background:linear-gradient(180deg,rgba(255,255,255,.14),rgba(255,255,255,.05));
    box-shadow:0 3px 0 rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.18);
    transition:transform .1s,box-shadow .1s,background .14s}
  .offGet:hover{background:linear-gradient(180deg,rgba(255,255,255,.2),rgba(255,255,255,.08))}
  .offGet:active{transform:translateY(3px);box-shadow:0 0 0 rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.14)}

  /* ---- interactive tutorial: dim everything, cut a hole, explain, wait ---- */
  #tutLayer{position:absolute;inset:0;z-index:26;display:none;pointer-events:none}
  #tutLayer.on{display:block}
  /* four panels build the dim area, leaving an un-dimmed gap in the middle.
     Using four divs instead of one box-shadow keeps the hole click-through. */
  .tutDim{position:absolute;background:rgba(2,6,14,.66);pointer-events:none;
    transition:all .32s cubic-bezier(.4,0,.2,1)}
  #tutRing{position:absolute;border:2px solid var(--glow);border-radius:14px;
    pointer-events:none;box-shadow:0 0 0 1px rgba(2,6,14,.5),0 0 28px rgba(95,242,214,.45);
    transition:all .32s cubic-bezier(.4,0,.2,1)}
  #tutRing:after{content:"";position:absolute;inset:-6px;border-radius:18px;
    border:2px solid rgba(95,242,214,.4);animation:tutPulse 1.9s ease-out infinite}
  @keyframes tutPulse{0%{transform:scale(.97);opacity:.9}70%{transform:scale(1.09);opacity:0}100%{opacity:0}}

  #tutCard{position:absolute;width:290px;padding:15px 17px 14px;border-radius:15px;
    background:rgba(6,16,34,.97);border:1px solid rgba(140,220,255,.2);backdrop-filter:blur(12px);
    box-shadow:0 18px 44px rgba(0,0,0,.6);pointer-events:auto;
    transition:all .32s cubic-bezier(.4,0,.2,1)}
  #tutCard .step{font-size:9.5px;font-weight:900;letter-spacing:.2em;color:#6f87a8}
  #tutCard h4{font-size:15px;font-weight:900;color:#eafff9;margin-top:5px}
  #tutCard p{font-size:12.5px;line-height:1.5;color:#a9bcd6;margin-top:6px}
  #tutCard p b{color:var(--glow)}
  /* progress meter: tap count, or how far down you have travelled */
  #tutMeter{height:5px;border-radius:99px;background:rgba(255,255,255,.1);overflow:hidden;
    margin-top:11px;display:none}
  #tutMeter.on{display:block}
  #tutMeter i{display:block;height:100%;width:0;border-radius:99px;
    background:linear-gradient(90deg,#2bbf9f,var(--glow));transition:width .18s linear}
  #tutFoot{display:flex;align-items:center;gap:10px;margin-top:13px}
  #tutDots{display:flex;gap:5px;margin-right:auto}
  #tutDots i{width:6px;height:6px;border-radius:99px;background:rgba(255,255,255,.18)}
  #tutDots i.on{background:var(--glow)}
  #tutSkip{font-size:11.5px;font-weight:800;color:#7f93b4;padding:6px 10px;border-radius:8px;
    transition:color .15s,background .15s}
  #tutSkip:hover{color:#cfe4ff;background:rgba(255,255,255,.06)}
  #tutNext{font-size:13px;font-weight:900;color:#04231c;padding:10px 17px;border-radius:12px;
    background:linear-gradient(180deg,#8dffe6,var(--glow) 45%,#25b59a);
    box-shadow:0 3px 0 #17836f,inset 0 1px 0 rgba(255,255,255,.5);
    transition:transform .1s,box-shadow .1s,filter .12s}
  #tutNext:hover{filter:brightness(1.06);transform:translateY(-1px)}
  #tutNext:active{transform:translateY(3px);box-shadow:0 0 0 #17836f}
  #tutNext.hide{display:none}
  /* three chevrons drifting downward in the water — unmistakable "go down" */
  #tutArrow{position:absolute;left:0;top:0;display:none;flex-direction:column;align-items:center;
    gap:2px;color:var(--glow);pointer-events:none;filter:drop-shadow(0 0 14px rgba(95,242,214,.55))}
  #tutArrow.on{display:flex}
  #tutArrow svg{width:44px;height:44px;opacity:0;animation:tutFall 1.8s ease-in-out infinite}
  #tutArrow svg:nth-child(2){animation-delay:.22s}
  #tutArrow svg:nth-child(3){animation-delay:.44s}
  @keyframes tutFall{
    0%{opacity:0;transform:translateY(-14px)}
    35%{opacity:1}
    100%{opacity:0;transform:translateY(26px)}}
  #stage.tiny #tutCard{width:320px}
  #stage.tiny #tutCard h4{font-size:16.5px}
  #stage.tiny #tutCard p{font-size:13.5px}

