  .mbox .gain{font-size:33px;font-weight:900;color:var(--glow);margin:8px 0 2px;font-variant-numeric:tabular-nums}
  .mBtn{display:inline-block;padding:14px 30px;border-radius:15px;font-size:15px;font-weight:900;color:#04231c;
    background:linear-gradient(180deg,#8dffe6,var(--glow) 45%,#25b59a);margin-top:6px;
    text-shadow:0 1px 0 rgba(255,255,255,.35);transition:transform .1s,box-shadow .1s,filter .12s;
    box-shadow:0 4px 0 #17836f,0 9px 20px rgba(60,220,190,.35),inset 0 1px 0 rgba(255,255,255,.55)}
  .mBtn:hover{filter:brightness(1.06);transform:translateY(-1px)}
  .mBtn:active{transform:translateY(4px);box-shadow:0 0 0 #17836f,inset 0 1px 0 rgba(255,255,255,.4)}
  .mBtn.ghost{background:rgba(255,255,255,.08);color:#a9bcd6;margin-left:8px;text-shadow:none;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}
  .mBtn.ghost:active{transform:translateY(2px);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}
  .tut{display:flex;gap:12px;align-items:center;text-align:left;margin:8px 0;padding:10px 12px;border-radius:13px;
    background:rgba(120,200,255,.05);border:1px solid var(--line)}
  .tut .n{width:26px;height:26px;border-radius:99px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;
    font-size:12px;font-weight:900;color:#04231c;background:var(--glow)}
  .tut p{margin:0;font-size:12.5px;color:#c6d8f0;line-height:1.4}
  /* plain, non-blocking data notice (no pop-up, per the consent guidance) */
  .consent{margin-top:16px;padding-top:12px;border-top:1px solid rgba(140,220,255,.1);
    font-size:10.5px;line-height:1.5;color:#6f81a0}

  #fab{display:none;position:absolute;right:16px;bottom:16px;z-index:12;padding:13px 20px;border-radius:99px;
    font-size:14px;font-weight:900;color:#04231c;background:linear-gradient(135deg,var(--glow),#2bbf9f);
    box-shadow:0 8px 26px rgba(60,220,190,.45)}
  #fabDot{width:8px;height:8px;border-radius:99px;background:#04231c;opacity:0;transition:opacity .2s}
  #fabDot.show{opacity:.85}
  /* ---- readability on the smallest required iframe sizes ----
     At 821×462 the stage scales to 0.64, so every UI size is multiplied by
     that. These overrides keep the smallest text at an effective ~7.5px+
     and enlarge touch targets when the viewport is small.               */
  #stage.tiny .sub,#stage.tiny .secNote,#stage.tiny .adFoot{font-size:12px;line-height:1.5}
  #stage.tiny .nm{font-size:14.5px}
  #stage.tiny .buyBtn{font-size:13.5px;min-width:92px;padding:9px 10px}
  #stage.tiny .buyBtn .q{font-size:11.5px}
  #stage.tiny .scName{font-size:15px}
  #stage.tiny .scTag,#stage.tiny .scTankTxt{font-size:11.5px}
  #stage.tiny .scStat{font-size:13.5px}
  #stage.tiny .sBtn b{font-size:12.5px}
  #stage.tiny .sBtn span{font-size:13px}
  #stage.tiny .sBtn small{font-size:11.5px}
  #stage.tiny #tabs button,#stage.tiny #subs button{font-size:13px;padding:10px 0}
  #stage.tiny .statRow{font-size:13px}
  #stage.tiny #brand{font-size:12.5px}
  #stage.tiny #glimCap{font-size:12.5px}
  #stage.tiny #perSec{font-size:14.5px}
  #stage.tiny .shardChip{font-size:13px}
  #stage.tiny #scrollHint{font-size:13px}
  #stage.tiny .toast{font-size:14px}
  #stage.tiny .chip .nm{font-size:13px}
  #stage.tiny .ascHero p{font-size:12.5px}
  #stage.tiny .mbox p,#stage.tiny .tut p{font-size:14px}
  #panel.fold{transform:translateX(112%)}
  #stage.folded #controls{right:18px}
  #stage.folded #chips,#stage.folded #toasts{transform:translateX(-50%)}
  #stage.folded #milestone{transform:translate(-50%,-50%) scale(.85)}
  #stage.folded #milestone.show{transform:translate(-50%,-50%) scale(1)}
  /* ---- small displays ------------------------------------------------
     Below 1080 px the fixed 344 px panel eats too much of a 1280 px stage,
     so it narrows in two steps and finally becomes a slide-over sheet with
     a permanent button. The upgrades are reachable at every single size. */
  #stage.narrow #panel{width:296px}
  #stage.narrow #controls{right:324px}
  #stage.narrow #chips,#stage.narrow #toasts{transform:translateX(calc(-50% - 156px))}
  #stage.narrow #milestone{transform:translate(calc(-50% - 156px),-50%) scale(.85)}
  #stage.narrow #milestone.show{transform:translate(calc(-50% - 156px),-50%) scale(1)}
  #stage.narrow .buyBtn{width:94px;flex:0 0 94px;font-size:13px}
  #stage.narrow .card{grid-template-columns:34px 1fr auto;padding:9px}
  #stage.narrow .ic{width:34px;height:34px}
  #stage.narrow .ic svg{width:19px;height:19px}
  #stage.narrow .scard{width:440px}
  #stage.narrow .scBtns{gap:5px}

  /* slide-over sheet: the panel floats above the scene and can always be opened */
  #stage.compact #panel{width:320px;max-width:86%;transform:translateX(112%);
    box-shadow:-22px 0 60px rgba(0,0,0,.6)}
  #stage.compact #panel.open{transform:none}
  #stage.compact #fab{display:flex;align-items:center;gap:7px}
  /* a scrim so the world behind the open sheet stops competing for attention */
  #sheetScrim{position:absolute;inset:0;z-index:7;background:rgba(2,6,14,.45);
    display:none;backdrop-filter:blur(1px)}
  #stage.compact #panel.open~#sheetScrim{display:block}
  #stage.compact .scard{width:min(92vw,430px)}
  #stage.compact .scBtns{grid-template-columns:1fr 1fr}
  #stage.compact .scBtns .sBtn:first-child{grid-column:1/3}
  #stage.compact #controls{right:18px}
  #stage.compact #chips,#stage.compact #toasts{transform:translateX(-50%)}
  #stage.compact #milestone{transform:translate(-50%,-50%) scale(.85)}
  #stage.compact #milestone.show{transform:translate(-50%,-50%) scale(1)}
</style>
