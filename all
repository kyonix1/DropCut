<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>DEEPGLOW</title>
<meta name="description" content="DEEPGLOW — lower your lamp into the dark, build deep-sea stations and haul glow to the surface.">
<!-- CrazyGames HTML5 SDK v3.
     Loaded with `async` so it can NEVER block parsing or the first frame.
     boot() polls for it briefly and initialises it in the background; the game
     is fully playable if this request is slow, blocked or fails entirely. -->
<script async src="https://sdk.crazygames.com/crazygames-sdk-v3.js"></script>
<style>
  :root{
    --bg:#02050c; --ink:#eaf3ff; --dim:#8ea2c2; --glow:#5ff2d6; --gold:#ffcf6b; --amber:#ff9d3c;
    --card:rgba(120,200,255,.05); --line:rgba(140,220,255,.10); --good:#7dffa8;
    --font:"Avenir Next","Segoe UI",ui-rounded,system-ui,-apple-system,Roboto,"Helvetica Neue",sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;background:var(--bg);overflow:hidden}
  body{font-family:var(--font);color:var(--ink);display:flex;align-items:center;justify-content:center;
    -webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none;-webkit-touch-callout:none}
  button{font-family:var(--font);border:none;background:none;color:inherit;cursor:pointer}
  svg{display:block}
  /* the stage already carries the sky/sea gradient, so the very first paint
     shows the scene's colours even before the canvas has drawn a single frame */
  #stage{position:relative;width:1280px;height:720px;flex:0 0 auto;overflow:hidden;border-radius:6px;
    background:linear-gradient(180deg,#08101f 0%,#15294c 14%,#2b4d70 26%,#12324e 30%,#0a2238 55%,#040f1f 80%,#01040a 100%);
    box-shadow:0 30px 90px rgba(0,0,0,.7);touch-action:none}
  #game{position:absolute;inset:0;width:100%;height:100%;cursor:pointer}
  .hud{position:absolute;pointer-events:none;z-index:5}
  .hud>*{pointer-events:auto}

  #topbar{left:22px;top:15px}
  #brand{font-size:11.5px;letter-spacing:.4em;color:var(--dim);font-weight:700}
  #glimLine{display:flex;align-items:baseline;gap:9px;margin-top:2px}
  #glimVal{font-size:33px;font-weight:800;font-variant-numeric:tabular-nums;color:#eafff9;text-shadow:0 0 26px rgba(95,242,214,.32)}
  #glimCap{font-size:11px;color:var(--dim);font-weight:700;letter-spacing:.18em}
  #perSec{font-size:13px;color:var(--good);font-weight:700;font-variant-numeric:tabular-nums}
  #shardLine{margin-top:4px;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
  .shardChip{background:rgba(255,207,107,.1);border:1px solid rgba(255,207,107,.3);color:#ffe3a6;
    font-size:11.5px;font-weight:700;border-radius:999px;padding:3px 10px}
  /* who is playing + optional cloud-save sign-in (never a nag, always a choice) */
  .userChip{display:flex;align-items:center;gap:6px;background:rgba(120,200,255,.07);
    border:1px solid rgba(140,220,255,.22);border-radius:999px;padding:2px 10px 2px 3px;
    font-size:11.5px;font-weight:800;color:#cfe4ff;max-width:210px}
  .userChip img{width:19px;height:19px;border-radius:99px;background:#0a1626;object-fit:cover}
  .userChip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .saveChip{display:flex;align-items:center;gap:5px;background:rgba(120,200,255,.07);
    border:1px solid rgba(140,220,255,.22);border-radius:999px;padding:3px 10px;
    font-size:11px;font-weight:800;color:#9fc4e8;transition:background .15s,border-color .15s}
  .saveChip:hover{background:rgba(120,200,255,.16);border-color:rgba(140,220,255,.45)}
  .saveChip svg{width:12px;height:12px;flex:0 0 auto}

  #depthHud{left:24px;bottom:20px;display:flex;align-items:baseline;gap:7px}
  #depthNum{font-size:40px;font-weight:800;color:#cdeeff;font-variant-numeric:tabular-nums;line-height:1;
    text-shadow:0 0 30px rgba(120,200,255,.3)}
  #depthUnit{font-size:16px;font-weight:800;color:#7f9dc0}
  #scrollHint{position:absolute;left:26px;bottom:74px;font-size:11.5px;font-weight:800;letter-spacing:.14em;
    color:rgba(150,220,255,.72);pointer-events:none;transition:opacity .5s}
  #scrollHint.hide{opacity:0}
  #scrollHint i{display:inline-block;animation:bob 1.8s ease-in-out infinite;font-style:normal}
  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(4px)}}

  #controls{right:372px;top:15px;display:flex;gap:8px}
  .iconBtn{width:40px;height:40px;border-radius:13px;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(180deg,rgba(18,34,58,.85),rgba(8,18,36,.8));border:1px solid var(--line);
    color:#9fb2cc;backdrop-filter:blur(8px);
    box-shadow:0 2px 0 rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.1);
    transition:transform .1s,box-shadow .1s,color .15s,border-color .15s}
  .iconBtn:hover{color:var(--ink);border-color:rgba(140,220,255,.35)}
  .iconBtn:active{transform:translateY(2px);box-shadow:0 0 0 rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.08)}
  .iconBtn.on{color:var(--glow)}

  /* ---- sound menu: anchored directly under its own button ---- */
  .ctrlWrap{position:relative;display:flex}
  #sndMenu{position:absolute;top:calc(100% + 7px);left:50%;transform:translateX(-50%);
    width:168px;display:none;flex-direction:column;gap:1px;
    background:rgba(6,16,34,.97);border:1px solid rgba(140,220,255,.16);border-radius:12px;
    padding:5px;backdrop-filter:blur(12px);box-shadow:0 14px 36px rgba(0,0,0,.55);z-index:16}
  #sndMenu.open{display:flex}
  /* little pointer up to the button */
  #sndMenu:before{content:"";position:absolute;top:-5px;left:50%;margin-left:-5px;
    width:9px;height:9px;background:rgba(6,16,34,.97);
    border-left:1px solid rgba(140,220,255,.16);border-top:1px solid rgba(140,220,255,.16);
    transform:rotate(45deg)}
  .sndOpt{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;
    text-align:left;padding:9px 11px;border-radius:9px;font-size:12.5px;font-weight:800;
    color:#a9bcd6;transition:background .13s,color .13s}
  .sndOpt:hover{background:rgba(95,242,214,.1);color:#eafff9}
  .sndOpt.act{color:#eafff9}
  .sndOpt i{font-style:normal;color:var(--glow);opacity:0;font-size:12px}
  .sndOpt.act i{opacity:1}
  #stage.tiny .sndOpt{font-size:13.5px}
  /* when the panel is folded the buttons sit near the edge — keep the menu inside */
  #stage.folded #sndMenu,#stage.compact #sndMenu{left:auto;right:-8px;transform:none}
  #stage.folded #sndMenu:before,#stage.compact #sndMenu:before{left:auto;right:20px;margin:0}

  #chips{left:50%;top:14px;transform:translateX(calc(-50% - 180px));display:flex;flex-direction:column;gap:6px;align-items:center}
  .chip{min-width:200px;background:rgba(8,20,40,.82);border:1px solid var(--line);border-radius:12px;padding:6px 12px 8px;backdrop-filter:blur(8px)}
  .chip .nm{font-size:12px;font-weight:800;display:flex;justify-content:space-between;gap:12px}
  .chip .bar{height:3px;border-radius:99px;background:rgba(255,255,255,.12);margin-top:5px;overflow:hidden}
  .chip .bar i{display:block;height:100%;border-radius:99px;background:var(--glow)}
  .chip.golden{border-color:rgba(255,205,90,.5)} .chip.golden .nm{color:var(--gold)} .chip.golden .bar i{background:var(--gold)}
  .chip.up .nm{color:#9ff2c9} .chip.dn .nm{color:#9fb3d9} .chip.dn .bar i{background:#8fa8cf}

  #toasts{position:absolute;left:50%;top:112px;transform:translateX(calc(-50% - 180px));display:flex;flex-direction:column;
    gap:8px;align-items:center;z-index:9;pointer-events:none}
  .toast{background:rgba(6,16,34,.92);border:1px solid var(--line);padding:9px 18px;border-radius:13px;font-size:13px;
    font-weight:700;box-shadow:0 10px 30px rgba(0,0,0,.5);text-align:center;max-width:430px;backdrop-filter:blur(8px);
    opacity:0;transform:translateY(-10px);transition:opacity .28s,transform .28s}
  .toast.in{opacity:1;transform:none}
  .toast.gold{border-color:rgba(255,205,90,.5);color:#ffe9bd}

  #milestone{position:absolute;left:50%;top:40%;transform:translate(calc(-50% - 180px),-50%) scale(.85);z-index:10;
    pointer-events:none;text-align:center;opacity:0;transition:opacity .4s,transform .45s cubic-bezier(.2,1.5,.35,1)}
  #milestone.show{opacity:1;transform:translate(calc(-50% - 180px),-50%) scale(1)}
  #milestone .mCard{padding:24px 44px;border-radius:22px;background:linear-gradient(160deg,rgba(95,242,214,.15),rgba(4,12,28,.95));
    border:1px solid rgba(95,242,214,.45);box-shadow:0 0 70px rgba(70,240,210,.2),0 24px 60px rgba(0,0,0,.6)}
  #milestone h2{font-size:27px;font-weight:900;color:#c8fff2;letter-spacing:.04em}
  #milestone p{font-size:12.5px;color:var(--dim);margin-top:6px;font-weight:700;letter-spacing:.1em}

  #world{position:absolute;inset:0;z-index:4;pointer-events:none;overflow:hidden}
  .scard{position:absolute;left:0;top:0;width:520px;padding:10px 12px 11px;border-radius:16px;
    background:rgba(5,14,30,.82);border:1px solid rgba(140,220,255,.16);backdrop-filter:blur(10px);
    pointer-events:auto;box-shadow:0 14px 38px rgba(0,0,0,.5);display:none;will-change:transform;transition:opacity .25s}
  .scard.on{display:block} .scard.dim{opacity:.4}
  .scHead{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .scName{font-size:15px;font-weight:900}
  .scTag{font-size:11px;font-weight:800;color:#a6bad4;background:rgba(255,255,255,.08);padding:3px 9px;border-radius:99px}
  .scTag.lv{color:#04231c;background:linear-gradient(135deg,var(--glow),#2bbf9f)}
  .scTag.ov{color:#2a1405;background:linear-gradient(135deg,#ffe3a6,var(--amber))}
  .scStat{margin-left:auto;font-size:12px;font-weight:800;color:var(--good);font-variant-numeric:tabular-nums}
  .scTankRow{display:flex;align-items:center;gap:8px;margin-top:8px}
  .scTank{flex:1;height:7px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}
  .scTank i{display:block;height:100%;width:0%;border-radius:99px;background:linear-gradient(90deg,#2bbf9f,var(--glow));transition:width .18s linear}
  .scTank.full i{background:linear-gradient(90deg,var(--amber),#ff7b5e)}
  .scTankTxt{font-size:10px;font-weight:800;color:var(--dim);font-variant-numeric:tabular-nums;min-width:122px;text-align:right}
  .scBtns{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px;margin-top:9px}
  /* station console buttons: same chunky, pressable language as the shop */
  .sBtn{position:relative;padding:10px 11px;border-radius:13px;text-align:left;
    background:linear-gradient(180deg,rgba(120,255,232,.20),rgba(95,242,214,.09));
    border:1px solid rgba(95,242,214,.3);
    box-shadow:0 3px 0 rgba(12,90,78,.5),inset 0 1px 0 rgba(255,255,255,.14);
    transition:transform .1s,box-shadow .1s,background .14s}
  .sBtn:hover{background:linear-gradient(180deg,rgba(130,255,236,.3),rgba(95,242,214,.16));transform:translateY(-1px)}
  .sBtn:active{transform:translateY(3px);box-shadow:0 0 0 rgba(12,90,78,.5),inset 0 1px 0 rgba(255,255,255,.1)}
  /* fixed line heights so a longer price or effect text never grows the row */
  .sBtn b{display:block;font-size:12.5px;font-weight:900;color:#e4fffa;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .sBtn span{display:block;font-size:14px;font-weight:900;color:#fff;font-variant-numeric:tabular-nums;
    margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .sBtn small{display:block;font-size:10.5px;color:#9fc0d8;font-weight:700;margin-top:2px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .sBtn.off{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07);cursor:default;
    box-shadow:none;transform:none}
  .sBtn.off b{color:#8697b8} .sBtn.off span{color:#6d7d9c}
  .sBtn.deploy{background:linear-gradient(180deg,#ffdf9e,#ff9d3c);border-color:rgba(255,200,110,.6);
    box-shadow:0 3px 0 #a85f12,0 7px 16px rgba(255,170,60,.34),inset 0 1px 0 rgba(255,255,255,.5)}
  .sBtn.deploy:active{transform:translateY(3px);box-shadow:0 0 0 #a85f12,inset 0 1px 0 rgba(255,255,255,.4)}
  .sBtn.deploy b{color:#3a2405} .sBtn.deploy span{color:#1f1300} .sBtn.deploy small{color:#6b4611}
  .sBtn.done{background:rgba(255,227,166,.12);border-color:rgba(255,207,107,.28);cursor:default;
    box-shadow:none;transform:none}
  .sBtn.done b{color:#ffe3a6} .sBtn.done span{color:#ffd9a0}
  .sBtn.lock{background:rgba(255,255,255,.03);border-color:rgba(255,255,255,.06);cursor:default;
    box-shadow:none;transform:none}
  .sBtn.lock b{color:#7c8ba8} .sBtn.lock span{color:#6d7d9c}

  #panel{position:absolute;right:14px;top:14px;bottom:14px;width:344px;z-index:8;background:rgba(4,11,26,.86);
    border:1px solid var(--line);border-radius:20px;backdrop-filter:blur(16px);display:flex;flex-direction:column;
    overflow:hidden;transition:transform .32s cubic-bezier(.2,.9,.25,1)}
  #tabs{display:flex;gap:6px;padding:12px 12px 6px}
  #tabs button{flex:1;padding:11px 0;font-size:13.5px;font-weight:900;letter-spacing:.02em;border-radius:13px;
    color:#9fb2cc;background:rgba(255,255,255,.05);transition:all .16s;position:relative}
  #tabs button:hover{color:var(--ink);background:rgba(255,255,255,.09)}
  #tabs button.act{color:#04231c;background:linear-gradient(180deg,#8dffe6,var(--glow) 50%,#2bbf9f);
    box-shadow:0 3px 0 #17836f,inset 0 1px 0 rgba(255,255,255,.5)}
  #tabs button .dot{position:absolute;top:6px;right:9px;width:7px;height:7px;border-radius:99px;background:var(--good);display:none}
  #tabs button .dot.show{display:block}
  #subs{display:flex;gap:5px;padding:4px 12px 8px}
  #subs.hide{display:none}
  #subs{flex-wrap:wrap}
  #subs button{flex:1 1 auto;min-width:64px;padding:9px 6px;font-size:11.5px;font-weight:900;border-radius:11px;
    color:#8fa4c0;background:rgba(255,255,255,.04);border:1px solid transparent;transition:all .16s;position:relative;
    white-space:nowrap}
  #subs button:hover{color:var(--ink);background:rgba(255,255,255,.08)}
  #subs button.act{color:#eafff9;background:rgba(95,242,214,.2);border-color:rgba(95,242,214,.5)}
  /* the shop entry is special: a warm gold frame sets it apart from upgrades */
  #subs button.shopTab{color:#ffe3a6;background:linear-gradient(180deg,rgba(255,207,107,.14),rgba(255,157,60,.06));
    border-color:rgba(255,207,107,.45);box-shadow:inset 0 1px 0 rgba(255,235,190,.16)}
  #subs button.shopTab:hover{color:#fff3d6;background:linear-gradient(180deg,rgba(255,207,107,.22),rgba(255,157,60,.1))}
  #subs button.shopTab.act{color:#3a2405;background:linear-gradient(180deg,#ffe9b8,#ffcf6b);
    border-color:rgba(255,207,107,.9);box-shadow:0 2px 0 #a6600f,inset 0 1px 0 rgba(255,255,255,.5)}
  #subs button.shopTab .d{background:var(--gold)}
  #subs button .d{position:absolute;top:5px;right:7px;width:6px;height:6px;border-radius:99px;background:var(--good);display:none}
  #subs button .d.show{display:block}
  #list{flex:1;overflow-y:auto;padding:2px 10px 16px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.18) transparent;
    overscroll-behavior:contain;touch-action:pan-y}
  #list::-webkit-scrollbar{width:6px}
  #list::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:99px}

  .secNote{font-size:11.5px;color:#8298b8;margin:9px 4px 3px;line-height:1.5}

  /* ---- skin shop: one tall card per skin, preview on the left ---- */
  .skRow{display:grid;grid-template-columns:66px 1fr;gap:12px;align-items:center;margin:10px 0;
    padding:12px;border-radius:17px;border:1px solid var(--line);
    background:linear-gradient(180deg,rgba(120,200,255,.07),rgba(120,200,255,.02));
    transition:border-color .35s ease,background .35s ease,box-shadow .35s ease}
  .skRow:hover{border-color:rgba(140,220,255,.3)}
  .skRow.on{border-color:rgba(95,242,214,.55);
    background:linear-gradient(180deg,rgba(95,242,214,.12),rgba(95,242,214,.03))}
  /* a single soft glow travelling down the row when it is equipped */
  /* Skins change instantly: no flash, no pulse, no glow. */
  .skRow{transition:none}
  .skTag{transition:none}
  .skBtn.equipped{transition:background .3s ease,color .3s ease,border-color .3s ease}
  /* the preview is a live animated canvas, so each icon shows the skin's
     actual shape, colours and particle behaviour — not a static swatch */
  /* preview: one centred orb whose colour, shape and motion match the skin */
  .skPrev{width:66px;height:66px;border-radius:16px;position:relative;overflow:hidden;
    display:flex;align-items:center;justify-content:center;background:#04101a;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.07)}
  .skRow.on .skPrev{box-shadow:inset 0 0 0 1px rgba(95,242,214,.5),0 0 16px rgba(95,242,214,.22)}
  /* every preview is the same round lamp; the effect layer tells them apart */
  .skOrb{width:30px;height:30px;position:relative;border-radius:99px;
    background:radial-gradient(circle at 34% 30%,var(--c),var(--m) 55%,var(--r));
    box-shadow:0 0 15px rgba(var(--a),.7),inset 0 1px 2px rgba(255,255,255,.4)}
  /* soft halo, always perfectly centred behind the orb */
  .skOrb:before{content:"";position:absolute;left:50%;top:50%;width:54px;height:54px;
    transform:translate(-50%,-50%);border-radius:99px;pointer-events:none;
    background:radial-gradient(circle,rgba(var(--a),.4),rgba(var(--a),0) 70%)}

  /* ember — a warm flicker */
  .skOrb.fx-ember{animation:skFlick 1.5s ease-in-out infinite}
  @keyframes skFlick{0%,100%{filter:brightness(1)}50%{filter:brightness(1.25)}}

  /* void — a planet: tilted ring turning around the sphere */
  .skOrb.fx-orbit:after{content:"";position:absolute;left:50%;top:50%;width:50px;height:20px;
    transform:translate(-50%,-50%) rotate(-18deg);border-radius:99px;pointer-events:none;
    border:2px solid rgba(var(--a),.6);animation:skRing 4s linear infinite}
  @keyframes skRing{
    0%{transform:translate(-50%,-50%) rotate(-18deg) scaleX(1)}
    50%{transform:translate(-50%,-50%) rotate(-18deg) scaleX(.55)}
    100%{transform:translate(-50%,-50%) rotate(-18deg) scaleX(1)}}

  /* prism — a mirror ball: colour wedges sweeping around it */
  .skOrb.fx-prism{background:conic-gradient(#ff5f8f,#ffd166,#6bffb0,#5fd8ff,#b07bff,#ff5f8f);
    animation:skSpin 3.2s linear infinite}
  .skOrb.fx-prism:after{content:"";position:absolute;inset:0;border-radius:99px;pointer-events:none;
    background:radial-gradient(circle at 32% 28%,rgba(255,255,255,.9),rgba(255,255,255,0) 55%)}
  @keyframes skSpin{to{transform:rotate(360deg)}}

  /* eye — a breathing iris with a pupil */
  .skOrb.fx-eye{animation:skBreathe 2.8s ease-in-out infinite}
  .skOrb.fx-eye:after{content:"";position:absolute;left:50%;top:50%;width:10px;height:10px;
    transform:translate(-50%,-50%);border-radius:99px;background:#04140e;pointer-events:none;
    box-shadow:0 0 0 3px rgba(var(--a),.55)}
  @keyframes skBreathe{0%,100%{transform:scale(1)}50%{transform:scale(1.09)}}
  .skName{font-size:14px;font-weight:900;color:#eaf5ff;display:flex;align-items:center;gap:7px}
  .skDesc{font-size:11.5px;color:#8fa5c2;margin-top:3px;line-height:1.4}
  .skAct{margin-top:9px;display:flex;gap:7px;align-items:center}
  /* Skin buttons: no motion at all, only a quiet brightness change */
  .skBtn{flex:1;padding:10px;border-radius:12px;font-size:13px;font-weight:900;color:#04231c;
    background:linear-gradient(180deg,#8dffe6,var(--glow) 45%,#25b59a);position:relative;
    box-shadow:0 3px 0 #17836f,inset 0 1px 0 rgba(255,255,255,.5);
    transition:filter .18s ease;text-shadow:0 1px 0 rgba(255,255,255,.3)}
  .skBtn:hover{filter:brightness(1.06)}
  .skBtn:active{filter:brightness(.94)}
  .skBtn.flash{animation:none!important}
  .skBtn.flash:before,.skBtn.flash:after{content:none!important}
  .skBtn.off{background:rgba(255,255,255,.06);color:#76839f;cursor:default;box-shadow:none;
    text-shadow:none;transform:none}
  .skBtn.equipped{background:rgba(95,242,214,.14);color:#9ff0e0;cursor:default;box-shadow:none;
    border:1px solid rgba(95,242,214,.4);text-shadow:none;transform:none}
  .skTag{font-size:9.5px;font-weight:900;letter-spacing:.1em;color:#04231c;background:var(--glow);
    padding:2px 7px;border-radius:99px}
  /* rare skins: the gold lives on the row and its badge only — the buy
     button stays the same as every other button in the game */
  .rareTag{font-size:9.5px;font-weight:900;letter-spacing:.1em;color:#3a2405;
    background:linear-gradient(180deg,#ffe9b8,var(--gold));padding:2px 7px;border-radius:99px}
  .skRow.rare{border-color:rgba(255,207,107,.5);
    background:linear-gradient(180deg,rgba(255,207,107,.08),rgba(255,157,60,.02));
    box-shadow:0 0 0 1px rgba(255,207,107,.14),0 0 18px rgba(255,170,60,.1)}
  .skRow.rare:hover{border-color:rgba(255,207,107,.75)}
  .skRow.rare .skPrev{box-shadow:inset 0 0 0 1px rgba(255,207,107,.35)}
  .skRow.rare.on{border-color:rgba(255,207,107,.85);
    box-shadow:0 0 0 1px rgba(255,207,107,.3),0 0 22px rgba(255,170,60,.18)}
  .adFoot{font-size:10px;color:#6f81a0;line-height:1.45;margin:16px 3px 2px;padding-top:11px;
    border-top:1px solid rgba(140,220,255,.1)}
  .adFoot b{color:#9db3d4}
  .sec{font-size:10px;font-weight:900;letter-spacing:.18em;color:var(--dim);margin:15px 2px 2px;display:flex;align-items:center;gap:10px}
  .sec:after{content:"";flex:1;height:1px;background:rgba(140,220,255,.12)}
  /* Essential / Extra divider inside a category */
  .grp{display:flex;align-items:center;gap:9px;margin:16px 3px 4px;
    font-size:10.5px;font-weight:900;letter-spacing:.16em}
  .grp:before,.grp:after{content:"";flex:1;height:1px;background:rgba(140,220,255,.14)}
  .grp.key{color:var(--glow)}
  .grp.key:before,.grp.key:after{background:rgba(95,242,214,.28)}
  .grp.opt{color:#6f81a0}
  /* the important upgrades get a slightly stronger card */
  .card.key{border-color:rgba(95,242,214,.28);
    background:linear-gradient(180deg,rgba(95,242,214,.09),rgba(120,200,255,.03))}
  .card.key:hover{border-color:rgba(95,242,214,.45)}
  .card{display:grid;grid-template-columns:44px 1fr auto;gap:11px;align-items:center;
    background:linear-gradient(180deg,rgba(120,200,255,.07),rgba(120,200,255,.03));
    border:1px solid var(--line);border-radius:17px;padding:11px;margin:9px 0;transition:border-color .15s,background .15s}
  .card:hover{border-color:rgba(140,220,255,.3);background:linear-gradient(180deg,rgba(120,200,255,.11),rgba(120,200,255,.04))}
  .card.gc{border-color:rgba(255,205,90,.3);background:linear-gradient(160deg,rgba(255,190,80,.07),rgba(120,200,255,.03))}
  .card.lock{opacity:.5}
  /* a cap that means "perfectly tuned", not "you are blocked" */
  .card.opt{border-color:rgba(95,242,214,.4);background:linear-gradient(160deg,rgba(95,242,214,.09),rgba(120,200,255,.03))}
  .card.opt .sub{color:#8fe4d4}
  .buyBtn.opt{background:rgba(95,242,214,.16);color:#9ff0e0;border:1px solid rgba(95,242,214,.4);cursor:default}
  .ic{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(180deg,rgba(95,242,214,.18),rgba(95,242,214,.06));
    box-shadow:inset 0 1px 0 rgba(255,255,255,.12);color:var(--glow);flex:0 0 auto}
  .ic svg{width:24px;height:24px}
  .nm{font-size:14px;font-weight:900;display:flex;align-items:center;gap:6px;flex-wrap:wrap;color:#eaf5ff}
  .sub{font-size:11.5px;color:#93a9c6;margin-top:3px;line-height:1.45}
  /* Upgrade rows only: pin the description to exactly two lines. Buying an
     upgrade rewrites this text, and a jump from one line to two would push
     every card below it downwards. Stat blocks keep their natural height. */
  .sub.fix{min-height:2.9em;display:-webkit-box;-webkit-line-clamp:2;
    -webkit-box-orient:vertical;overflow:hidden}
  .sub b{color:#bfe9ff}
  .buy{display:flex;align-items:center;gap:7px}
  /* A FIXED width, not min-width: the price text changes length on every
     purchase ("1.2K" → "1.44K"), and a flexible button would resize and
     nudge the whole row sideways. Tabular figures keep digits aligned. */
  .buyBtn{position:relative;width:104px;flex:0 0 104px;padding:10px 6px;border-radius:14px;
    font-size:14px;font-weight:900;color:#04231c;text-align:center;white-space:nowrap;
    background:linear-gradient(180deg,#8dffe6,var(--glow) 45%,#25b59a);
    box-shadow:0 3px 0 #17836f,0 7px 16px rgba(60,220,190,.34),inset 0 1px 0 rgba(255,255,255,.55);
    transition:transform .1s,box-shadow .1s,filter .12s;font-variant-numeric:tabular-nums;
    text-shadow:0 1px 0 rgba(255,255,255,.35)}
  /* no filter:brightness — it repaints the whole element and rendered in the
     wrong place inside the scaled QA iframe. A stronger shadow does the job. */
  .buyBtn:hover{
    box-shadow:0 3px 0 #17836f,0 9px 22px rgba(95,242,214,.55),inset 0 1px 0 rgba(255,255,255,.65)}
  .buyBtn:active{transform:translateY(3px);
    box-shadow:0 0 0 #17836f,0 3px 10px rgba(60,220,190,.3),inset 0 1px 0 rgba(255,255,255,.4)}
  /* while the press animation runs it owns the transform */
  .buyBtn.flash:active{transform:none}
  .buyBtn.off{background:rgba(255,255,255,.06);color:#76839f;cursor:default;text-shadow:none;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.07);transform:none}
  .buyBtn .q{display:block;font-size:10px;font-weight:800;opacity:.75;letter-spacing:.06em;margin-bottom:1px}
  /* a gentle nudge when something just became affordable */
  @keyframes buyReady{0%,100%{box-shadow:0 3px 0 #17836f,0 7px 16px rgba(60,220,190,.34),inset 0 1px 0 rgba(255,255,255,.55)}
    50%{box-shadow:0 3px 0 #17836f,0 7px 22px rgba(95,242,214,.55),inset 0 1px 0 rgba(255,255,255,.55)}}
  .buyBtn:not(.off):not(.opt){animation:buyReady 3.4s ease-in-out infinite}

  /* ---- reward feedback on a successful press ------------------------------
     Deliberately calm: one soft press, one slow halo that fades out, and a
     label that drifts up. No sparks, no snapping, nothing that flickers.   */
  /* A press, plus a splash box that expands out of the button's own edges.
     The splash is a CHILD of the button with inset offsets — no JS coordinate
     maths, so it cannot drift when the stage is scaled (QA iframe sizes). */
  .flash{animation:flashPress .85s cubic-bezier(.22,.7,.2,1)}
  @keyframes flashPress{
    0%{transform:translateY(3px)}
    18%{transform:translateY(3px)}
    45%{transform:translateY(-1px)}
    100%{transform:translateY(0)}}
  /* the glow sits outside the button's own box, on its own layer */
  /* The glow is a radial cloud centred on the button. Its box is centred with
     translate(-50%,-50%) once — the keyframes only add the breathing scale on
     top, so it can never drift sideways. */
  /* splash box: a ring that starts on the button's edge and expands outward */
  .fRing{position:absolute;inset:0;pointer-events:none;z-index:1;
    border-radius:inherit;border:2px solid rgba(140,255,232,.85);
    box-shadow:0 0 14px rgba(95,242,214,.5),inset 0 0 10px rgba(160,255,238,.35);
    opacity:0;animation:fBloom .95s cubic-bezier(.2,.55,.2,1) forwards}
  .fRing.gold{border-color:rgba(255,215,140,.9);
    box-shadow:0 0 14px rgba(255,190,90,.5),inset 0 0 10px rgba(255,215,140,.35)}
  @keyframes fBloom{
    0%{opacity:.95;transform:scale(1)}
    100%{opacity:0;transform:scale(1.5)}}


  /* the floating label: slow, quiet, no bounce */
  /* the label drifts straight up and fades — no scaling, no bounce */
  .rwPop{position:absolute;left:50%;top:-4px;pointer-events:none;z-index:32;
    font-size:13.5px;font-weight:900;color:#eafff9;
    text-shadow:0 2px 10px rgba(0,0,0,.75);will-change:opacity,transform;
    animation:rwFloat 1.6s cubic-bezier(.22,.5,.18,1) forwards;white-space:nowrap;letter-spacing:.02em}
  .rwPop.gold{color:#ffe3a6}
  @keyframes rwFloat{
    0%{opacity:0;transform:translate(-50%,0)}
    18%{opacity:1;transform:translate(-50%,-10px)}
    60%{opacity:.85}
    100%{opacity:0;transform:translate(-50%,-34px)}}

  /* the card breathes once, barely noticeable */
  .card.rw,.scard.rw{animation:cardRw 1.2s cubic-bezier(.22,.5,.18,1)}
  @keyframes cardRw{
    0%{box-shadow:0 0 0 0 rgba(95,242,214,.22)}
    100%{box-shadow:0 0 0 10px rgba(95,242,214,0)}}
  .buyBtn.free{background:linear-gradient(135deg,#9dffc2,#3ddb7a);color:#04231c;animation:freePop .5s ease}
  @keyframes freePop{0%{transform:scale(1)}40%{transform:scale(1.12)}100%{transform:scale(1)}}

  /* small, clearly-an-ad skip icon — deliberately NOT styled like the buy button */
  .adBtn{width:24px;height:24px;flex:0 0 auto;border-radius:7px;display:flex;align-items:center;justify-content:center;
    background:rgba(255,255,255,.05);border:1px dashed rgba(190,170,255,.4);color:#bda7ff;opacity:.55;
    transition:opacity .15s,background .15s,border-color .15s;position:relative}
  .adBtn:hover{opacity:1;background:rgba(150,120,255,.16);border-color:rgba(190,170,255,.8)}
  .adBtn svg{width:13px;height:13px}
  .adBtn:hover:after{content:"Watch Ad → Upgrade for Free";position:absolute;right:0;bottom:114%;
    white-space:nowrap;font-size:10px;font-weight:800;color:#e8ddff;background:rgba(14,12,34,.97);
    border:1px solid rgba(190,170,255,.4);padding:4px 8px;border-radius:7px;pointer-events:none;z-index:30}

  /* active boost timer, top right of the play area */
  #boostHud{right:372px;top:62px;display:none;min-width:206px;padding:9px 13px 10px;border-radius:14px;
    background:rgba(8,20,40,.88);backdrop-filter:blur(10px);border:1px solid rgba(255,207,107,.55)}
  #boostHud.on{display:block}
  #boostHud.blue{border-color:rgba(110,190,255,.6)}
