/* =========================================================================================
   INTERACTIVE TUTORIAL
   Four steps, each one waits for the player to actually do the thing. The rest
   of the screen dims, the target gets a pulsing ring, and a small card explains
   why. Skippable at every step, and never shown twice.
   ========================================================================================= */
const TUT={
  on:false, i:0, watch:null,
  el:{ layer:document.getElementById('tutLayer'), ring:document.getElementById('tutRing'),
       card:document.getElementById('tutCard'), step:document.getElementById('tutStep'),
       title:document.getElementById('tutTitle'), text:document.getElementById('tutText'),
       dots:document.getElementById('tutDots'), next:document.getElementById('tutNext'),
       t:document.getElementById('tutT'), b:document.getElementById('tutB'),
       l:document.getElementById('tutL'), r:document.getElementById('tutR'),
       arrow:document.getElementById('tutArrow'),
       meter:document.getElementById('tutMeter'), fill:document.getElementById('tutMeterFill') },

  steps:[
    { title:'Tap the lamp',
      text:'Your lamp is the only light down here. <b>Tap it</b> a few times to collect Glow.',
      // a circle around the lamp, in stage coordinates
      rect:()=>({x:LAMP_SX-46,y:LAMP_SY-46,w:92,h:92,round:99}),
      count:()=>({now:Math.min(S.clicks,5),of:5}),
      done:()=>S.clicks>=5 },

    { title:'Dive down',
      text:'<b>Scroll down</b> with your mouse wheel, or <b>drag the water upwards</b>. A build site is waiting at 40 metres.',
      // highlight the whole water column, not a small strip — the action is
      // "move the world", so the world itself is the target
      rect:()=>({x:40,y:150,w:W-420,h:H-200,round:20}),
      arrow:true,                     // falling chevrons in the middle of the water
      card:{x:W-700,y:H-210},         // tucked into the corner, clear of the arrow
      progress:()=>clamp(camY/Math.max(1,ST[0].y-LAMP_SY-120),0,1),
      done:()=>camY>=ST[0].y-LAMP_SY-120 },

    { title:'Build your first station',
      text:'This station works on its own and never stops. <b>Press Build Station</b> to deploy it.',
      rect:()=>TUT.cardBtn(0,'lv'),
      done:()=>S.lv[0]>0,
      hint:()=>S.glim<lvCost(0)?'Keep tapping the lamp until you can afford it.':null },

    { title:'Extend the cable',
      text:'The station fills a tank and the collector hauls it up. A <b>Longer Cable</b> reaches the next station, deeper down.',
      tab:'bell',
      rect:()=>TUT.panelBtn('[data-lamp="cable"]'),
      auto:3,                          // the cable is usually not affordable yet,
                                       // so this step just shows it for 3 seconds
      done:()=>S.lamp.cable>=1 }
  ],

  /* --- helpers that locate a live element in stage coordinates --- */
  box(el){
    if(!el)return null;
    const s=stage.getBoundingClientRect(), r=el.getBoundingClientRect();
    if(!r.width)return null;
    const sc=s.width/W;
    return {x:(r.left-s.left)/sc, y:(r.top-s.top)/sc, w:r.width/sc, h:r.height/sc, round:12};
  },
  cardBtn(i,kind){
    const c=cards[i]; if(!c||!c.on)return null;
    return this.box(c.el.querySelector(`[data-b="${kind}"]`));
  },
  panelBtn(sel){ return this.box(listEl.querySelector(sel)); },

  start(){
    if(this.on)return;
    // a fresh world always earns the tutorial, whatever the flag says
    const fresh=(totLv()===0&&S.clicks<6&&(S.total||0)<50&&S.asc===0);
    if(S.seenTut&&!fresh)return;
    // seenTut is written only on completion/Skip. Reloading halfway through
    // correctly restarts the short tutorial instead of silently skipping it.
    this.on=true; tutActive=true; this.i=0;
    this.el.layer.classList.add('on');
    this.el.dots.innerHTML=this.steps.map(()=>'<i></i>').join('');
    this.show();
    this.watch=setInterval(()=>this.tick(),120);
  },
  show(){
    const s=this.steps[this.i];
    this.t0=Date.now();                          // for steps that time out
    this.el.step.textContent='STEP '+(this.i+1)+' OF '+this.steps.length;
    this.el.title.textContent=s.title;
    this.el.text.innerHTML=s.text;
    [...this.el.dots.children].forEach((d,k)=>d.classList.toggle('on',k<=this.i));
    this.el.next.classList.add('hide');           // every step is completed by doing it
    this.el.meter.classList.toggle('on',!!(s.count||s.progress||s.auto));
    this.el.arrow.classList.toggle('on',!!s.arrow);
    if(s.tab){ tab='up'; sub=s.tab; syncTabs(); renderPanel();
      panelEl.classList.remove('fold'); stage.classList.remove('folded'); collapsed=false;
      panelEl.classList.add('open'); }
    this.place();
  },
  place(){
    const s=this.steps[this.i];
    let r=null; try{ r=s.rect(); }catch(e){}
    const L=this.el;
    if(!r){ // target not on screen yet: keep the card visible, dim nothing
      for(const k of ['t','b','l','r']){ L[k].style.width='0'; L[k].style.height='0';
        L[k].style.pointerEvents='none'; }
      L.ring.style.opacity='0'; L.arrow.classList.remove('on');
      L.card.style.left=(W/2-145)+'px'; L.card.style.top=(H-210)+'px';
      return;
    }
    // park the falling chevrons in the middle of the highlighted water
    if(s.arrow){ L.arrow.style.left=(r.x+r.w/2-22)+'px'; L.arrow.style.top=(r.y+r.h*.42)+'px'; }
    const pad=10, x=r.x-pad, y=r.y-pad, w=r.w+pad*2, h=r.h+pad*2;
    L.t.style.cssText=`left:0;top:0;width:${W}px;height:${Math.max(0,y)}px`;
    L.b.style.cssText=`left:0;top:${y+h}px;width:${W}px;height:${Math.max(0,H-y-h)}px`;
    L.l.style.cssText=`left:0;top:${y}px;width:${Math.max(0,x)}px;height:${h}px`;
    L.r.style.cssText=`left:${x+w}px;top:${y}px;width:${Math.max(0,W-x-w)}px;height:${h}px`;
    // set properties individually — cssText += would grow forever
    L.ring.style.left=x+'px'; L.ring.style.top=y+'px';
    L.ring.style.width=w+'px'; L.ring.style.height=h+'px';
    L.ring.style.borderRadius=(r.round||12)+'px'; L.ring.style.opacity='1';
    // the dim is purely visual guidance — it must never block the player,
    // e.g. step 3 asks you to keep tapping the lamp while the station is ringed
    for(const k of ['t','b','l','r'])L[k].style.pointerEvents='none';
    // place the card on whichever side has room
    let cx,cy;
    if(s.card){ cx=s.card.x; cy=s.card.y; }        // a step may pin it explicitly
    else {
      cx=x+w+18; cy=y+h/2-70;
      if(cx+290>W-14)cx=x-290-18;
      if(cx<14){ cx=clamp(x+w/2-145,14,W-304); cy=(y>H/2)?y-170:y+h+18; }
    }
    L.card.style.left=clamp(cx,14,W-304)+'px';
    L.card.style.top=clamp(cy,14,H-190)+'px';
  },
  tick(){
    if(!this.on)return;
    const s=this.steps[this.i];
    // live hint line, e.g. "keep tapping until you can afford it"
    if(s.hint){ const hx=s.hint();
      const base=s.text;
      this.el.text.innerHTML=hx?base+' <span style="color:#ffcf6b">'+hx+'</span>':base; }
    // progress meter: a tap counter, or how far down you have travelled
    if(s.count){ const c=s.count();
      this.el.fill.style.width=(c.now/c.of*100)+'%';
      this.el.step.textContent='STEP '+(this.i+1)+' OF '+this.steps.length+'  ·  '+c.now+' / '+c.of; }
    else if(s.progress) this.el.fill.style.width=(s.progress()*100)+'%';
    // a timed step shows the remaining seconds and closes itself
    if(s.auto){
      const left=Math.max(0,s.auto-(Date.now()-this.t0)/1000);
      this.el.fill.style.width=(left/s.auto*100)+'%';
      this.el.step.textContent='STEP '+(this.i+1)+' OF '+this.steps.length+'  ·  '+Math.ceil(left)+'s';
      if(left<=0){ this.finish(true); return; }
    }
    this.place();
    let ok=false; try{ ok=s.done(); }catch(e){}
    if(ok)this.advance();
  },
  advance(){
    SFX.good();
    if(this.i>=this.steps.length-1){ this.finish(true); return; }
    this.i++; this.show();
  },
  finish(completed){
    if(!this.on)return;
    this.on=false; tutActive=false; clearInterval(this.watch); this.watch=null;
    this.el.layer.classList.remove('on'); this.el.arrow.classList.remove('on');
    S.seenTut=true; save();
    if(completed){ milestone('READY TO DIVE','the trench is yours'); SFX.mile(); }
  }
};
