/* ---------------- number suffixes ----------------
   1K 1M 1B 1T, then letter pairs: AA AB AC … AZ BA BB … ZZ, then AAA…
   Suffixes are generated once and cached, so formatting stays O(1) no
   matter how large the number gets.                                    */
const SUF_FIX=['','K','M','B','T'];
const SUF_CACHE=[];
function sufFor(t){
  if(t<SUF_FIX.length)return SUF_FIX[t];
  const c=SUF_CACHE[t]; if(c!==undefined)return c;
  let n=t-SUF_FIX.length, len=2, size=676;        // 26^2 two-letter combos
  while(n>=size){ n-=size; len++; size*=26; }     // then three letters, and so on
  let out='';
  for(let k=0;k<len;k++){ out=String.fromCharCode(65+(n%26))+out; n=(n/26)|0; }
  return SUF_CACHE[t]=out;
}
// powers of 1000, precomputed so formatting never calls Math.pow
const P1K=[1];
for(let i=1;i<=102;i++)P1K[i]=P1K[i-1]*1000;      // P1K[102] ≈ 1e306, the last finite step

/* ---------------- state ---------------- */
const KEY='deepglow_v4';
const RESET_PROGRESS=new URLSearchParams(location.search).get('resetProgress')==='true';
function defState(){ return { v:4, glim:0, run:0, total:0, pearls:0, asc:0,
  lv:ST.map(()=>0), tankLv:ST.map(()=>0), over:ST.map(()=>false), tank:ST.map(()=>0),
  lamp:{cable:0,bulb:0}, bell:{winch:0,hold:0,extra:0}, ship:0,
  ups:{}, per:{}, muted:false, snd:'all', clicks:0, played:0, miles:[], last:Date.now(), deep:0, best:0,
  skin:'classic', skins:['classic'], seenTut:false }; }
let S=defState();
function save(now){ S.last=now||Date.now(); const j=JSON.stringify(S); Store.set(KEY,j); return j; }
function mergeSave(raw){
  try{ const d=typeof raw==='string'?JSON.parse(raw):raw; if(!d||typeof d!=='object')return;
    const t=defState(); for(const k of Object.keys(t)) if(d[k]!==undefined)t[k]=d[k];
    const fresh=defState();
