/* ---- reward feedback on a button press ---------------------------------
   Called from every successful purchase. Adds a one-shot bloom to the button
   and floats a short label above it. Self-cleaning, so nothing accumulates. */
function rewardFlash(el,label,gold){
  if(!el)return;
  el.classList.remove('flash');
  void el.offsetWidth;                 // restart the press on a repeat click
  el.classList.add('flash');
  clearTimeout(el._flashT);
  el._flashT=setTimeout(()=>el.classList.remove('flash'),1020);

  // The splash is a child of the button itself and uses inset:0, so it always
  // sits exactly on the button no matter how the stage is scaled. Measuring
  // with getBoundingClientRect() broke here: the stage is CSS-scaled, so those
  // screen pixels were applied again inside the scaled container.
  const r=document.createElement('span');
  r.className='fRing'+(gold?' gold':'');
  el.appendChild(r);
  r.addEventListener('animationend',()=>r.remove());
  setTimeout(()=>r.remove(),1300);                    // safety net

  const host=el.closest('.card')||el.closest('.scard')||el.parentElement;
  if(host){
    host.classList.remove('rw'); void host.offsetWidth; host.classList.add('rw');
    clearTimeout(host._rwT);
    host._rwT=setTimeout(()=>host.classList.remove('rw'),1250);
    if(label){
      // attached to the button, centred on it by CSS alone — no measuring,
      // so a scaled stage can never push it off target
      const p=document.createElement('span');
      p.className='rwPop'+(gold?' gold':''); p.textContent=label;
      el.appendChild(p);
      p.addEventListener('animationend',()=>p.remove());
      setTimeout(()=>p.remove(),1800);
    }
  }
  // a single soft chime, no rapid two-note chirp
  if(!isQuiet())tone(gold?620:500,.16,'sine',.04,0,gold?880:720);
}
