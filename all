/* ---------------- creatures: sparse, water only, weirder with depth ---------------- */
const KINDS=[['fish','fish','ray'],['fish','ray','jelly'],['jelly','squid','lantern'],
             ['squid','angler','siphon'],['angler','siphon','whale']];
const CRIT=[], CRIT_MAX=11, CRIT_KEEP=2600;   // keep-alive band around the camera
function zoneAt(wy){ return clamp(Math.floor((wy-SEA)/1200),0,4); }
/* entry: how far off-screen a creature starts.
   'far'  normal spawn, swims in slowly   ·  'edge' just outside the frame,
   used when a depth looks empty          ·  'on' already in view (boot only) */
function makeCreature(wy,entry){
  const z=zoneAt(wy),k=KINDS[z][Math.floor(Math.random()*3)],dir=Math.random()<.5?-1:1;
  const off=entry==='edge'?70:190;
  return {k,z,
    x:entry==='on'?rand(-100,W+100):(dir>0?-off:W+off),
    y:wy,
    vx:dir*rand(7,26)*(k==='whale'?.4:k==='siphon'?.5:1),
    vy:rand(-3.5,3.5)*(k==='whale'?.4:1),        // slow natural drift in depth
    s:rand(.75,1.35)*(k==='whale'?1.8:1),ph:Math.random()*7};
}
/* Creatures live in WORLD space and keep swimming whether or not you are
   looking at them. Scrolling past a fish and coming back finds it further
   along its path — it is never culled just because the camera moved.
   They are only removed once they have genuinely swum off the sides, or
   drifted absurdly far (2600 px) from the play area. */
function tickCreatures(dt){
  const top=camY-CRIT_KEEP, bot=camY+H+CRIT_KEEP;
  for(let i=CRIT.length-1;i>=0;i--){
    const c=CRIT[i];
    c.x+=c.vx*dt;
    c.y+=c.vy*dt;
    if(c.y<SEA+60){ c.y=SEA+60; c.vy=Math.abs(c.vy); }    // never break the surface
    if(c.x<-340||c.x>W+340||c.y<top||c.y>bot)CRIT.splice(i,1);
  }
  // how many are currently within sight? keep that band populated
  let near=0;
  for(const c of CRIT) if(c.y>camY-500&&c.y<camY+H+500)near++;
  // an empty stretch of water fills in quickly; a busy one stays calm
  const rate=near===0?6:near<3?2.4:1.2;
  if(CRIT.length<CRIT_MAX&&near<6&&Math.random()<dt*rate){
    const lo=Math.max(SEA+70,camY-300), hi=camY+H+300;
    if(hi>lo)CRIT.push(makeCreature(rand(lo,hi),near<2?'edge':'far'));
  }
}
/* fill the visible band once at boot / after a prestige so the first screen
   is already alive instead of slowly populating */
function seedCreatures(){
  CRIT.length=0;
  for(let i=0;i<5;i++){
    const wy=rand(Math.max(SEA+90,camY+40),camY+H-40);
    CRIT.push(makeCreature(wy,'on'));
  }
}

/* ---------------- bells ---------------- */
let bells=[],winchSpin=0,winchPulse=0;
function syncBells(){ const n=bellN();
  while(bells.length<n)bells.push({y:WINCH_Y+(deepBuilt()-WINCH_Y)*(bells.length/Math.max(1,n)),dir:1,load:0});
  while(bells.length>n)bells.pop(); }
function tickBells(dt){
  const sp=bellSpeed(),bot=deepBuilt(),hold=bellHold();
  for(const b of bells){
    const from=b.y, dir=b.dir;
    const raw=from+sp*dt*dir;
    const hitBottom=dir>0&&raw>=bot, hitTop=dir<0&&raw<=WINCH_Y;
    const to=hitBottom?bot:hitTop?WINCH_Y:raw;
    // Use the whole travelled segment, not only the final position. At high
    // winch levels a bell can move >28 px per frame and used to skip stations.
    const lo=Math.min(from,to)-28, hi=Math.max(from,to)+28;
    for(let i=0;i<ST.length;i++){ if(S.lv[i]<1||S.tank[i]<=0)continue;
      if(ST[i].y>=lo&&ST[i].y<=hi){ const room=hold-b.load; if(room<=0)break;
        const take=Math.min(room,S.tank[i]); b.load+=take; S.tank[i]-=take; } }
    b.y=to;
    if(hitBottom)b.dir=-1;
    if(hitTop){
      b.dir=1;
      if(b.load>0){ addGlim(b.load); winchPulse=1; SFX.deliver();
        const sy=WINCH_Y-camY;
        if(sy>-40&&sy<H+40){ pop(CABLE_X+36,sy+2,'+'+fmt(b.load),'#9ffcf0');
          for(let i=0;i<4;i++)parts.push({x:CABLE_X+rand(-6,6),y:sy+10,vx:rand(-16,16),vy:-rand(40,80),
            t:0,life:rand(.35,.6),s:rand(1.4,2.6),c:'#9ffcf0',g:120,w:0}); }
        b.load=0;
      }
    }
  }
  winchSpin+=dt*2.2; winchPulse=Math.max(0,winchPulse-dt*1.6);
}

