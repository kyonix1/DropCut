function addGlim(n){
  if(!(n>0))return;                               // reject NaN and non-positive values
  n=Math.min(SAFE_MAX,n);                         // Infinity becomes a safe finite cap
  const wasAbyss=S.total>=ABYSS_AT;
  S.glim=addSafe(S.glim,n); S.run=addSafe(S.run,n); S.total=addSafe(S.total,n);
  if(!wasAbyss&&S.total>=ABYSS_AT){               // the endgame layer opens once
    milestone('THE ABYSS OPENS','a new tier of upgrades awaits'); SFX.mile();
    toast('Abyss Tech unlocked — a new tab in your upgrades.','gold');
    syncTabs(); uiDirty=true;
  }
  for(let i=0;i<MILES.length;i++) if(S.run>=MILES[i][0]&&!S.miles.includes(i)){
    S.miles.push(i); milestone(MILES[i][1],MILES[i][2]); SFX.mile(); } }
function doTap(x,y,auto){
  if(S.paused)return;
  if(!started&&!auto)enterGameplay();
  S.clicks++;
  let a=tapPow(),crit=false;
