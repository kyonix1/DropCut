}
/* Darkness grows across the WHOLE trench instead of saturating just below
   the second station. A power curve makes it deepen quickly at first and
   then more slowly, so every new depth is still a visible step darker. */
function darkAt(wy){
  const t=(wy-SEA-40)/5400;
  if(t<=0)return 0;
  return t>=1?.975:Math.min(.975,Math.pow(t,.55));
