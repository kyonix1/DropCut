/* ---------------- offline time ----------------
   Offline earning starts the moment the game loses focus (tab hidden OR the
   window is blurred) and stops when the player comes back. On return we show
   what the rig hauled and offer an optional ad to triple it.
   Note: we never call gameplayStop on focus loss — the platform handles that. */
let hideAt=0, offlineShown=false;
const OFFLINE_MIN=45;                  // below this we just hand it over silently
function offlineBegin(){ if(hideAt)return; hideAt=Date.now(); save(); }
function offlineEnd(){
  if(!hideAt)return;
  const away=Math.min((Date.now()-hideAt)/1000,8*3600); hideAt=0;
  const g=income()*offlineEff()*away;
  if(g<=0)return;
  if(away<OFFLINE_MIN){ addGlim(g); return; }         // tiny gap, no popup
  queueOffline(away,g);
}
/* Something else may be showing (prestige confirm, fish choice, ad). The
   offline reward still has to appear the moment that overlay closes, instead
   of silently vanishing while the player is back in the game. */
let offlinePending=null;
function queueOffline(away,g){
  if(modal.classList.contains('show')||fishVeil.classList.contains('show')||adRunning){
    offlinePending=[away,g];
    // watch until whatever is open has been closed, then show immediately
    if(!offlineWatch){ offlineWatch=setInterval(()=>{
      if(modal.classList.contains('show')||fishVeil.classList.contains('show')||adRunning)return;
      clearInterval(offlineWatch); offlineWatch=null;
      const p=offlinePending; offlinePending=null;
      if(p)showOfflineReward(p[0],p[1]);
    },80); }
  } else showOfflineReward(away,g);
}
let offlineWatch=null;
/* one panel, used both on return-to-focus and at boot */
function showOfflineReward(away,g){
  if(offlineShown)return; offlineShown=true;
  // make sure no other overlay can swallow it: the reward owns the screen
  fishVeil.classList.remove('show'); fish=null;
  const canAd=Ads.ready();
  const play=`<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 4.5v15a1 1 0 0 0 1.53.85l12-7.5a1 1 0 0 0 0-1.7l-12-7.5A1 1 0 0 0 4 4.5z"/></svg>`;
  openModal(`<div class="offCard">
    <div class="offTop">
      <span class="offIco"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
      <span class="offAway">${fmtTime(away)} away</span>
    </div>
    <div class="offAmt">+${fmt(g)}</div>
    <div class="offUnit">GLOW</div>
    <div class="offBtns">
      ${canAd?`<button class="offAd" id="offAd">${play}<b>Triple it</b><i>${fmt(g*3)}</i></button>`:''}
      <button class="offGet" id="offOk">${canAd?'Collect':'Collect '+fmt(g)+' Glow'}</button>
    </div>
  </div>`,true);
  let paid=false;
  const pay=m=>{ if(paid)return; paid=true; addGlim(g*m); offlineShown=false;
    if(m>1){ SFX.chime(); toast('Offline Glow tripled — +'+fmt(g*3)+'!','gold');
      burst(W/2,H/2,30,'#ffe27a',320,1.2,1.4,true); } else SFX.buy(); };
  const ok=document.getElementById('offOk');
  if(ok)ok.onclick=()=>{ pay(1); closeModal(); };
  const ad=document.getElementById('offAd');
  if(ad)ad.onclick=()=>{ closeModal();
    Ads.watch('Triple your offline Glow',good=>{ pay(good?3:1);
      if(!good)toast('Ad unavailable — your offline Glow was collected normally.'); }); };
}
document.addEventListener('visibilitychange',()=>{ document.hidden?offlineBegin():offlineEnd(); });
addEventListener('blur',offlineBegin);
addEventListener('focus',offlineEnd);
/* ---- sound menu: click the icon to open, pick a mode, or cycle on the go ---- */
const sndMenu=document.getElementById('sndMenu'), muteBtn=document.getElementById('muteBtn');
let sndOpen=false;
function closeSndMenu(){ sndOpen=false; sndMenu.classList.remove('open'); }
muteBtn.addEventListener('click',e=>{
  e.stopPropagation(); sndOpen=!sndOpen; sndMenu.classList.toggle('open',sndOpen);
  if(sndOpen)syncSndIcons();
});
// clicking anywhere else closes it
document.addEventListener('pointerdown',e=>{
  if(sndOpen&&!e.target.closest('#sndMenu')&&!e.target.closest('#muteBtn'))closeSndMenu();
});
sndMenu.addEventListener('click',e=>{
  const b=e.target.closest('[data-snd]'); if(!b)return;
  e.stopPropagation();
  S.snd=b.dataset.snd;
  S.muted=(S.snd==='off');          // kept for save compatibility
  applyMute(); save();
  if(S.snd!=='off'&&!CG.sdkMute)SFX.good();
});
// mouse wheel over the icon cycles through the three modes without opening it
muteBtn.addEventListener('wheel',e=>{
  e.preventDefault();
  const order=['all','quiet','off'];
  let i=order.indexOf(sndMode()); if(CG.sdkMute)i=2;
  i=(i+(e.deltaY>0?1:order.length-1))%order.length;
  S.snd=order[i]; S.muted=(S.snd==='off'); applyMute(); save();
},{passive:false});
document.getElementById('fab').addEventListener('click',()=>panelEl.classList.toggle('open'));
// tapping the dimmed world closes the sheet again
document.getElementById('sheetScrim').addEventListener('pointerdown',e=>{
  e.stopPropagation(); panelEl.classList.remove('open'); });

/* ---------------- loop ---------------- */
let lastT=performance.now(),saveT=0,ctxT=0,uiT=0;
function loop(now){
  requestAnimationFrame(loop);
  let dt=(now-lastT)/1000; lastT=now;
  if(dt>.25)dt=.25; if(dt<0)dt=0;
  evMults();
  camY+=(camTarget-camY)*Math.min(1,dt*10);
  if(Math.abs(camTarget-camY)<.4)camY=camTarget;
  if(camY>S.deep)S.deep=camY;
  if(S.paused){ draw(dt); placeWorld(); return; }   // frozen while an ad plays
  S.played+=dt;
  for(let i=0;i<ST.length;i++){ if(S.lv[i]<1)continue;
    const p=stRate(i)*dt;
    if(uL('pipe')){ addGlim(p); S.tank[i]=0; continue; }
    const cap=tankCap(i), room=cap-S.tank[i];
    if(p<=room)S.tank[i]+=p;
    else { S.tank[i]=cap; addGlim((p-room)*BELL_FLOOR); }   // overflow is skimmed by hand
  }
  if(!uL('pipe'))tickBells(dt);
  tickCreatures(dt);
  const ai=[4,2,1][uL('auto')-1];
  if(ai&&started){ autoT+=dt; if(autoT>=ai){ autoT=0; doTap(0,0,true); } }
  if(started&&!tutActive){ nextEv-=dt; if(nextEv<=0){ nextEv=rand(60,120); rollEvent(); } }
  // special fish: spawn timer, swimming, and the active boost countdown
  if(boost){ boost.t+=dt; if(boost.t>=boost.dur){ boost=null; toast('Boost ended.'); } refreshBoostHud(); }
  if(fish){ if(!fishVeil.classList.contains('show')){ fish.x+=fish.vx*dt; fish.t+=dt; }
    if(fish.x<-220||fish.x>W+220){ fish=null; fishTimer=rand(FISH_MIN,FISH_MAX); } }
  else if(started&&!boost&&!adRunning&&!S.paused){
    fishTimer-=dt; if(fishTimer<=0&&canSpawnFish())spawnFish(); }
  for(let i=active.length-1;i>=0;i--){ active[i].t+=dt; if(active[i].t>=active[i].dur)active.splice(i,1); }
  if(adCool>0){ const was=Math.ceil(adCool); adCool=Math.max(0,adCool-dt);
    if(Math.ceil(adCool)!==was)uiDirty=true; }
  draw(dt); placeWorld();
  saveT+=dt; if(saveT>10){ saveT=0; save(); }          // Data Module debounces internally
  ctxT+=dt; if(ctxT>30){ ctxT=0;
    CG.context({depth:metresAt(lampY())+' m',stations:totLv(),pearls:S.pearls,prestiges:S.asc});
    submitBest(); }                       // leaderboard: lifetime Glow, slow cadence
  uiT+=dt; if(uiT>.2){ uiT=0; refreshHUD(); updCards();
    const k=pKey(); if(uiDirty||k!==lastKey){ renderPanel(); lastKey=k; } }
}

function fit(){
  const sc=Math.min(innerWidth/W,innerHeight/H);
  stage.style.transform=`scale(${sc})`;
  // three layouts: full · narrow panel · slide-over sheet
  stage.classList.toggle('narrow',innerWidth>=880&&innerWidth<1180);
  stage.classList.toggle('compact',innerWidth<880);
  // small iframes shrink every pixel — enlarge the UI text so it stays readable
  // at devicePixelRatio 1 on 821×462, 907×510 and 800×450 (mobile)
  stage.classList.toggle('tiny',sc<.78);
  sizeCanvas();
  const v=ctx.createRadialGradient(W/2,H/2,H*.46,W/2,H/2,H*.92);
  v.addColorStop(0,'rgba(0,0,0,0)'); v.addColorStop(1,'rgba(0,2,6,.6)'); VIG=v;
}
addEventListener('resize',fit);

(async function boot(){
  /* ---------------------------------------------------------------------
     The scene must be on screen immediately — we never block the first
     frame on a network request. The SDK is initialised in parallel and
     the save is re-read from the Data Module as soon as it is ready.
     --------------------------------------------------------------------- */
  CG.loadingStart();

  // 1) instant local boot: read the local save and draw the very first frame
  if(RESET_PROGRESS)try{ localStorage.removeItem(KEY); }catch(e){}
  let raw=null; try{ raw=localStorage.getItem(KEY); }catch(e){}
  if(raw)mergeSave(raw);
  syncSndIcons();
  S.paused=false; syncBells(); buildWorld(); seedCreatures();
  fit(); syncTabs(); renderPanel(); refreshHUD();
  requestAnimationFrame(t=>{ lastT=t; requestAnimationFrame(loop); });

  refreshUserChip();
  // 2) onboarding / welcome-back appear IMMEDIATELY — never behind the SDK wait
  const away=Math.min((Date.now()-(S.last||Date.now()))/1000,8*3600);
  /* A player with genuinely no progress must ALWAYS get the tutorial, even if
     a stale seenTut flag survived somewhere (cloud save, partial reset, QA
     progress wipe). The state of the world decides, not a single flag. */
  const isNew=(totLv()===0&&S.clicks<6&&S.played<30&&(S.total||0)<50&&S.asc===0);
  if(isNew)S.seenTut=false;               // a wiped save means: teach again
  if(!isNew&&totLv()>0&&away>OFFLINE_MIN){
    const g=income()*offlineEff()*away;
    if(g>0)queueOffline(away,g);             // same panel as on return-to-focus
    if(!S.seenTut){ S.seenTut=true; save(); }
  }
  else if(!S.seenTut){
    // straight into the action: no title card, the tutorial starts on the scene
    // itself and can be left at any time via its own Skip button
    TUT.start();
  }
  enterGameplay();                            // playable the moment nothing covers the screen
  setInterval(()=>save(),10000);
  addEventListener('beforeunload',()=>save());
  // iOS: the AudioContext is interrupted in the background and only a real
  // gesture may resume it (technical requirements → resuming audio after iOS)
  document.addEventListener('touchend',()=>{ if(AC&&AC.state==='suspended')AC.resume(); },{passive:true});

  // 3) SDK afterwards, in the background — it can never delay the first screen
  try{
    await Promise.race([CG.init(),new Promise(r=>setTimeout(r,4000))]);
  }catch(e){}
  applyMute();
  CG.startAdProbe();          // begin the 3-second SDK/adblock eligibility check
  if(RESET_PROGRESS&&CG.data){
    try{ CG.data.removeItem(KEY); }catch(e){}
    S=defState(); camY=camTarget=0; bells=[]; syncBells(); updCards();
    if(TUT.on){ TUT.i=0; TUT.show(); } else TUT.start();
    renderPanel(); refreshHUD(); save();
    CG.loadingStop(); return;
  }
  if(CG.data){
    Store.migrate(KEY);                      // carry an older local save to the cloud
    try{
      const cloud=CG.data.getItem(KEY);
      if(cloud){
        const c=JSON.parse(cloud);
        // only adopt the cloud save if it is genuinely further along, and
        // only if this is a returning player with actual progress
        if(c&&(c.total||0)>0&&(!raw||(c.total||0)>=(JSON.parse(raw).total||0))){
          // A returning player on a new device may briefly see step 1 while
          // the SDK starts. Real cloud progress wins; stop the tutorial cleanly.
          if(TUT.on){
            TUT.on=false; tutActive=false; clearInterval(TUT.watch); TUT.watch=null;
            TUT.el.layer.classList.remove('on'); TUT.el.arrow.classList.remove('on');
          }
          // cosmetics are never lost: union the two skin lists before merging,
          // so a skin bought offline survives a cloud save taking over
          const localSkins=S.skins||[], localSkin=S.skin;
          mergeSave(cloud);
          for(const id of localSkins)
            if(SKINS.some(s=>s.id===id)&&S.skins.indexOf(id)<0)S.skins.push(id);
          if(localSkin&&S.skins.indexOf(localSkin)>=0&&S.skin==='classic')S.skin=localSkin;
          syncBells(); uiDirty=true; renderPanel(); refreshHUD(); save();
        }
      }
    }catch(e){}
  }
  CG.loadingStop();
})();
</script>
