  .spin{width:40px;height:40px;margin:4px auto 10px;border-radius:99px;border:3px solid rgba(255,255,255,.14);
    border-top-color:var(--glow);animation:spin 1s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}

  .ascHero{margin:8px 0;padding:14px;border-radius:16px;text-align:center;
