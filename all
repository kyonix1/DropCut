/* "h,s,l" → "r,g,b" string, used by the colour-cycling prism skin */
function hsl2rgb(h,s,l){
  h=((h%360)+360)%360/360;
  const q=l<.5?l*(1+s):l+s-l*s, p=2*l-q;
  const f=tt=>{ tt=(tt+1)%1;
    if(tt<1/6)return p+(q-p)*6*tt;
    if(tt<1/2)return q;
    if(tt<2/3)return p+(q-p)*(2/3-tt)*6;
    return p; };
