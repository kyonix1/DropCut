  #boostHud .bb i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--amber),var(--gold));transition:width .2s linear}
  #boostHud.blue .bb i{background:linear-gradient(90deg,#3f8fd8,#8fd0ff)}
