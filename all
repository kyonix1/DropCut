function drawLamp(dtl){
  const t=T,sy=LAMP_SY,gold=active.some(e=>e.id==='golden');
  const lv=S.lamp.bulb,pw=lampPow(),R=lightR();
  // Brighter Lamp changes ONLY the brightness and reach of the light.
  // No bubbles, no flames, no heat ring, no colour shift — the look of the
  // lamp is decided purely by the equipped skin.
  const SK=curSkin();
  // the prism skin cycles its colours over time
  const prismHue=(t*40)%360;
  const skAura=SK.fx==='prism'
    ? hsl2rgb(prismHue,.85,.7)
    : SK.aura;
  const skCore=SK.fx==='prism'?'#ffffff':SK.core;
  const skMid =SK.fx==='prism'?`hsl(${prismHue|0},90%,58%)`:SK.mid;
  const skRim =SK.rim;
  ctx.strokeStyle='rgba(150,190,220,.4)'; ctx.lineWidth=2;
  ctx.beginPath(); ctx.moveTo(LAMP_SX,Math.max(-10,SEA-camY)); ctx.lineTo(LAMP_SX,sy-34); ctx.stroke();
  const hc=gold?'255,215,110':skAura;
  const halo=ctx.createRadialGradient(LAMP_SX,sy,4,LAMP_SX,sy,R);
  halo.addColorStop(0,`rgba(${hc},${.36*pw+.14})`); halo.addColorStop(.42,`rgba(${hc},${.11*pw})`);
  halo.addColorStop(1,'rgba(95,242,214,0)');
  ctx.fillStyle=halo; ctx.beginPath(); ctx.arc(LAMP_SX,sy,R,0,6.283); ctx.fill();
  ctx.fillStyle='#17293c'; rr(LAMP_SX-14,sy-42,28,14,5); ctx.fill();
  ctx.strokeStyle='rgba(180,225,250,.35)'; ctx.lineWidth=1.3; rr(LAMP_SX-14,sy-42,28,14,5); ctx.stroke();
  // the glass always uses the skin's own colours; only its intensity varies
  const glass=ctx.createRadialGradient(LAMP_SX-8,sy-8,2,LAMP_SX,sy,30);
  glass.addColorStop(0,gold?'#fff3cd':skCore);
  glass.addColorStop(.45,gold?'#f0b53c':skMid);
  glass.addColorStop(1,skRim);
  // one round lamp for every skin — the colour and the effect do the talking
  ctx.fillStyle=glass; ctx.beginPath(); ctx.arc(LAMP_SX,sy,27,0,6.283); ctx.fill();
  ctx.strokeStyle='rgba(12,30,38,.7)'; ctx.lineWidth=2.4;
  for(let k=-1;k<=1;k++){ ctx.beginPath(); ctx.moveTo(LAMP_SX+k*13,sy-24);
    ctx.quadraticCurveTo(LAMP_SX+k*19,sy,LAMP_SX+k*13,sy+24); ctx.stroke(); }
  ctx.strokeStyle='rgba(190,235,250,.42)'; ctx.lineWidth=2;
  ctx.beginPath(); ctx.arc(LAMP_SX,sy,27,0,6.283); ctx.stroke();
  ctx.save(); ctx.globalCompositeOperation='lighter';
  const core=ctx.createRadialGradient(LAMP_SX,sy,1,LAMP_SX,sy,18+pump*9);
  core.addColorStop(0,`rgba(255,255,248,${.45+.5*pw})`);
  core.addColorStop(.5,gold?'rgba(255,205,95,.6)':`rgba(${skAura},${.35+.4*pw})`);
  core.addColorStop(1,`rgba(${skAura},0)`);
  ctx.fillStyle=core; ctx.beginPath(); ctx.arc(LAMP_SX,sy,18+pump*9,0,6.283); ctx.fill();
  ctx.restore();

  /* ---- skin-specific flourishes, drawn by the shared effect helpers ---- */
  // these three draw around the origin, so move it onto the lamp first
  if(SK.fx==='ember'){ ctx.save(); ctx.translate(LAMP_SX,sy); drawEmberFx(ctx,t,27); ctx.restore(); }
  else if(SK.fx==='orbit'){ ctx.save(); ctx.translate(LAMP_SX,sy); drawOrbitFx(ctx,t,40,skAura); ctx.restore(); }
  else if(SK.fx==='prism'){ ctx.save(); ctx.translate(LAMP_SX,sy); drawPrismFx(ctx,t,27); ctx.restore(); }
  else if(SK.fx==='eye'){ drawEyeFx(ctx,t,LAMP_SX,sy,27,skAura);
    ctx.strokeStyle=`rgba(${skAura},.3)`; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(LAMP_SX,sy,24+Math.sin(t*.7)*3,0,6.283); ctx.stroke(); }
  const ai=[4,2,1][uL('auto')-1];
  if(ai){ const p=(autoT%ai)/ai;
    ctx.strokeStyle=`rgba(255,220,150,${.4*(1-p)})`; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(LAMP_SX,sy,31+p*52,0,6.283); ctx.stroke(); }
}

const snow=[]; for(let i=0;i<70;i++)snow.push({x:Math.random()*W,y:Math.random()*H,r:rand(.6,1.7),sp:rand(7,20),a:rand(.08,.3),p:Math.random()*7});
function draw(dt){
  T+=dt;
  ctx.setTransform(bs,0,0,bs,0,0);
  if(shake>0){ shake=Math.max(0,shake-dt*24); ctx.translate(rand(-shake,shake),rand(-shake,shake)); }
  pump=Math.max(0,pump-dt*7);
  const g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,waterAt(camY)); g.addColorStop(1,waterAt(camY+H));
  ctx.fillStyle=g; ctx.fillRect(-30,-30,W+60,H+60);
  const seaSy=SEA-camY;
  if(seaSy>-140){
    const sky=ctx.createLinearGradient(0,seaSy-240,0,seaSy);
    sky.addColorStop(0,'#08101f'); sky.addColorStop(.65,'#15294c'); sky.addColorStop(1,'#2b4d70');
    ctx.fillStyle=sky; ctx.fillRect(-30,seaSy-260,W+60,260);
    ctx.fillStyle='rgba(235,242,255,.85)'; ctx.beginPath(); ctx.arc(900,seaSy-168,17,0,6.283); ctx.fill();
    drawShip(seaSy); drawWinch();
    ctx.fillStyle='rgba(190,235,255,.13)';
    for(let i=0;i<6;i++){ const w=170-i*20;
      ctx.fillRect(LAMP_SX-w/2+Math.sin(T*1.1+i)*24,seaSy+5+i*7,w,2.5); }
  }
  /* ---- depth-specific water character ----------------------------------
     Each zone gets its own signature so scrolling down genuinely changes
     the look of the water, not just its darkness.                        */
  const z=zoneAt(camY+H*.5);
  if(z<=2){                                   // sunlit → midnight: slow silt haze
    ctx.save(); ctx.globalCompositeOperation='lighter';
    for(let i=0;i<3;i++){
      const hy=((T*7+i*260)%(H+300))-150;
      const g2=ctx.createLinearGradient(0,hy,0,hy+220);
      g2.addColorStop(0,'rgba(90,150,190,0)'); g2.addColorStop(.5,'rgba(90,150,190,.035)');
      g2.addColorStop(1,'rgba(90,150,190,0)');
      ctx.fillStyle=g2; ctx.fillRect(0,hy,W,220); }
    ctx.restore();
  }
  if(z>=3){                                   // abyss / hadal: cold bioluminescent motes
    ctx.save(); ctx.globalCompositeOperation='lighter';
    for(let i=0;i<26;i++){
      const px=(i*137.5+Math.sin(T*.3+i)*40)%W;
      const py=((i*211+T*11)%(H+80))-40;
      const tw=.5+.5*Math.sin(T*1.7+i*1.3);
      ctx.fillStyle=`rgba(${z>=4?'150,190,255':'120,235,225'},${.10+.22*tw})`;
      ctx.beginPath(); ctx.arc(px,py,1.1+tw*1.2,0,6.283); ctx.fill(); }
    ctx.restore();
  }
  if(z>=4){                                   // hadal: heavy pressure vignette
    const pv=ctx.createRadialGradient(W*.42,H*.5,H*.22,W*.42,H*.5,H*.8);
    pv.addColorStop(0,'rgba(0,0,0,0)'); pv.addColorStop(1,'rgba(0,0,0,.4)');
    ctx.fillStyle=pv; ctx.fillRect(0,0,W,H);
  }

  ctx.fillStyle='rgba(205,232,255,.26)';
  for(const s of snow){ s.y+=s.sp*dt; if(s.y>H+8){s.y=-8;s.x=Math.random()*W;}
    ctx.globalAlpha=s.a*(z>=3?.55:1); ctx.beginPath(); ctx.arc(s.x+Math.sin(T*.5+s.p)*5,s.y,s.r,0,6.283); ctx.fill(); }
  ctx.globalAlpha=1;
  const cTop=Math.max(-10,WINCH_Y-camY),cBot=Math.min(H+10,deepBuilt()-camY+14);
  if(cBot>cTop){ ctx.strokeStyle='rgba(150,190,220,.26)'; ctx.lineWidth=3;
    ctx.beginPath(); ctx.moveTo(CABLE_X,cTop); ctx.lineTo(CABLE_X,cBot); ctx.stroke(); }
  // generous draw margin: leviathans and siphonophores are tall, they must
  // slide into view smoothly rather than pop in at the edge
  for(const c of CRIT){ const sy=c.y-camY; if(sy<-260||sy>H+260)continue; drawCreature(c,sy); }
  for(let i=0;i<ST.length;i++){ const sy=ST[i].y-camY;
    if(sy<-260||sy>H+260)continue; if(!reachedStation(i)&&S.lv[i]<1)continue; drawStation(i,sy); }
  for(const b of bells)drawBell(b);
  ctx.save(); ctx.globalCompositeOperation='lighter';
  for(let i=parts.length-1;i>=0;i--){ const p=parts[i]; p.t+=dt;
    if(p.t>p.life){parts.splice(i,1);continue;}
    p.vy+=(p.g||40)*dt*.05; p.x+=p.vx*dt+(p.w?Math.sin(p.t*4*p.w)*13*dt:0); p.y+=p.vy*dt;
    const a=1-p.t/p.life;
    ctx.globalAlpha=a*.8; ctx.fillStyle=p.c;
    ctx.beginPath(); ctx.arc(p.x,p.y,p.s*(.6+.4*a),0,6.283); ctx.fill(); }
  ctx.restore();
  for(let i=rings.length-1;i>=0;i--){ const r=rings[i]; r.t+=dt;
    if(r.t>r.life){rings.splice(i,1);continue;}
    const p=r.t/r.life;
    ctx.strokeStyle=`rgba(140,250,225,${.45*(1-p)})`; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(r.x,r.y,(r.b?18:9)+p*(r.b?100:55),0,6.283); ctx.stroke(); }
  const hw=dk.width,hh=dk.height;
  dctx.setTransform(1,0,0,1,0,0); dctx.clearRect(0,0,hw,hh);
  const dg=dctx.createLinearGradient(0,0,0,hh);
  dg.addColorStop(0,`rgba(1,4,10,${darkAt(camY)})`); dg.addColorStop(1,`rgba(1,4,10,${darkAt(camY+H)})`);
  dctx.fillStyle=dg; dctx.fillRect(0,0,hw,hh);
  dctx.globalCompositeOperation='destination-out';
  const R=lightR()*.5,fillv=lampFill();
  // clears at most exactly as much darkness as this depth has — never more
  const lg=dctx.createRadialGradient(LAMP_SX*.5,LAMP_SY*.5,0,LAMP_SX*.5,LAMP_SY*.5,R*1.25);
  lg.addColorStop(0,`rgba(0,0,0,${fillv})`);
  lg.addColorStop(.45,`rgba(0,0,0,${fillv*.78})`);
  lg.addColorStop(.75,`rgba(0,0,0,${fillv*.34})`);
  lg.addColorStop(1,'rgba(0,0,0,0)');
  dctx.fillStyle=lg; dctx.fillRect(0,0,hw,hh);
  for(let i=0;i<ST.length;i++){ if(S.lv[i]<1)continue;
    const sy=(ST[i].y-camY)*.5; if(sy<-160||sy>hh+160)continue;
    const r=(180+Math.min(130,Math.log10(1+S.lv[i])*72))*.5;
    const sg=dctx.createRadialGradient(ST_X*.5,sy,0,ST_X*.5,sy,r);
    sg.addColorStop(0,'rgba(0,0,0,.9)'); sg.addColorStop(.55,'rgba(0,0,0,.5)'); sg.addColorStop(1,'rgba(0,0,0,0)');
    dctx.fillStyle=sg; dctx.fillRect(ST_X*.5-r,sy-r,r*2,r*2); }
  for(const b of bells){ const sy=(b.y-camY)*.5; if(sy<-60||sy>hh+60)continue;
    const sg=dctx.createRadialGradient(CABLE_X*.5,sy,0,CABLE_X*.5,sy,48);
    sg.addColorStop(0,'rgba(0,0,0,.62)'); sg.addColorStop(1,'rgba(0,0,0,0)');
    dctx.fillStyle=sg; dctx.fillRect(CABLE_X*.5-48,sy-48,96,96); }
  dctx.globalCompositeOperation='source-over';
  ctx.drawImage(dk,0,0,W,H);
  const rs=reachY()-camY+170;
  if(rs<H){ const fg=ctx.createLinearGradient(0,rs-150,0,rs+40);
    fg.addColorStop(0,'rgba(1,3,8,0)'); fg.addColorStop(1,'rgba(1,3,8,1)');
    ctx.fillStyle=fg; ctx.fillRect(0,rs-150,W,190);
    ctx.fillStyle='#010308'; ctx.fillRect(0,Math.max(0,rs+38),W,H); }
  drawLamp(dt);
  drawFish();                      // special fish swim above the darkness, always visible

  ctx.textAlign='center';
  for(let i=pops.length-1;i>=0;i--){ const p=pops[i]; p.tm+=dt;
    if(p.tm>p.life){pops.splice(i,1);continue;}
    const a=1-p.tm/p.life,yy=p.y-58*p.tm+26*p.tm*p.tm;
    ctx.font=`900 ${p.b?25:18}px ${FNT}`; ctx.globalAlpha=Math.min(1,a*1.7);
    ctx.lineWidth=4; ctx.strokeStyle='rgba(1,10,14,.6)'; ctx.strokeText(p.t,p.x,yy);
    ctx.fillStyle=p.c; ctx.fillText(p.t,p.x,yy); ctx.globalAlpha=1; }
  ctx.setTransform(bs,0,0,bs,0,0);
  if(VIG){ ctx.fillStyle=VIG; ctx.fillRect(0,0,W,H); }
}

