  .fishTitle.blue{color:#8fd0ff}
  .fishOpts{display:flex;flex-direction:column;gap:9px;margin-top:16px}
  .fOpt{display:flex;align-items:center;gap:11px;padding:14px;border-radius:15px;text-align:left;
