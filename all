/* =========================================================================================
   ADS — rules honoured here
   · player-initiated only, never interrupting active play
   · 3-second on-screen warning before every ad (clicker guideline)
   · game paused + audio muted between adStarted and adFinished/adError
   · adError grants nothing and tells the player to try later
   · no chaining: one ad at a time plus a cooldown, shown as a timer in the UI
   · offers hidden entirely when an adblocker or Basic Launch makes them unfillable
   ========================================================================================= */
let adRunning=false, preAdMode='all', adCool=0;
const AD_COOLDOWN=90;                 // seconds between two rewarded offers
const adVeil=document.getElementById('adVeil'), adBox=document.getElementById('adBox');
function showAdBox(html){ adBox.innerHTML=html; adVeil.classList.add('show'); }
function hideAdBox(){ adVeil.classList.remove('show'); }
const Ads={
  busy(){ return adRunning; },
  ready(){ return ADS_ENABLED&&!adRunning&&adCool<=0&&CG.adsUsable(); },
  cooldownLeft(){ return Math.max(0,Math.ceil(adCool)); },

  /** 3s warning → rewarded ad → reward(true) only on adFinished */
  watch(label,reward){
    if(!this.ready())return;
    adRunning=true;
    let cd=3;
    showAdBox(`<h3>${label}</h3><p style="margin:10px 0 0">Ad starting in</p>
      <div id="cdNum">${cd}</div><p style="margin:2px 0 14px">seconds — stop tapping</p>
      <button class="mBtn ghost" id="cdCancel">Cancel</button>`);
    const iv=setInterval(()=>{
      cd--; const el=document.getElementById('cdNum');
      if(cd>0){ if(el)el.textContent=cd; return; }
      clearInterval(iv); this._request('rewarded',reward);
    },1000);
    const cb=document.getElementById('cdCancel');
    if(cb)cb.onclick=()=>{ clearInterval(iv); adRunning=false; hideAdBox(); };
  },

  /** midgame ad at a real break (prestige). SDK handles pacing; unfilled is fine. */
  midgame(done){
    if(adRunning||!CG.adsUsable()){ done&&done(); return; }
    adRunning=true;
    let cd=3;
    showAdBox(`<h3>Short break</h3><p style="margin:10px 0 0">Ad starting in</p>
      <div id="cdNum">${cd}</div><p style="margin:2px 0 14px">seconds</p>`);
    const iv=setInterval(()=>{
      cd--; const el=document.getElementById('cdNum');
      if(cd>0){ if(el)el.textContent=cd; return; }
      clearInterval(iv); this._request('midgame',()=>done&&done());
    },1000);
  },

  _request(type,cb){
    const started=()=>{ adPause(true);
      showAdBox(`<div class="spin"></div><h3>Ad running…</h3>
        <p style="margin:8px 0 0">Your rig is paused. Thanks for the support!</p>`); };
    const finish=(ok,err)=>{
      adPause(false); hideAdBox(); adRunning=false;
      if(type==='rewarded')adCool=AD_COOLDOWN;
      if(err){
        const code=err&&err.code;
        if(code==='adblock'){ CG.adblock=true; toast('Ads are blocked by your adblocker — rewards are unavailable.'); }
        else if(code==='adsDisabledBasicLaunch'){ CG.adsDisabled=true; }
        else if(type==='rewarded') toast('Ad not available, try again later.');
        uiDirty=true;
      }
      cb(ok);
    };
    if(CG.ok&&window.CrazyGames.SDK.ad){
      try{
        window.CrazyGames.SDK.ad.requestAd(type,{
          adStarted:started,
          adFinished:()=>finish(true),
          adError:e=>finish(false,e||{})
        });
        return;
      }catch(e){}
    }
    // no SDK available (offline / disabled env): simulate so the flow stays testable
    started(); setTimeout(()=>finish(true),1400);
  }
};
