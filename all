function freeGrant(kind,id){
  if(kind==='lamp'){ const d=upDef(LAMP_UPS,id)||upDef(BELL_UPS,id); if(!d||S.lamp[id]>=d.cap())return false;
    S.lamp[id]++; if(id==='cable')toast('Cable extended — you can now dive to '+fmt(metresAt(reachY()))+' m!','gold'); return true; }
  if(kind==='bell'){ const d=upDef(BELL_UPS,id); if(S.bell[id]>=d.cap())return false;
    S.bell[id]++; if(id==='extra')syncBells(); return true; }
