/* Render a list split into "the ones that matter" and "everything else".
   build(u) returns the row HTML for one upgrade. */
function group(list,build){
  const key=list.filter(u=>u.key), extra=list.filter(u=>!u.key);
  let h='';
  if(key.length){ h+=`<div class="grp key">MAIN UPGRADES</div>`; for(const u of key)h+=build(u); }
  if(extra.length){ h+=`<div class="grp opt">EXTRAS</div>`; for(const u of extra)h+=build(u); }
  return h;
}
function row(o){
  // a cost that has outgrown what a JS number can hold counts as maxed out
  const maxed=o.lvl>=o.cap||!isFinite(o.cost);
  const opt=maxed&&o.optimal;            // capped because it is perfectly tuned
  // the ad icon only exists when an ad can really be shown and rewarded
  const ad=(!maxed&&o.adAttr&&Ads.ready())
    ?`<button class="adBtn" ${o.adAttr} aria-label="Watch ad for a free upgrade">${FILM}</button>`:'';
  return `<div class="card ${o.key?'key':''} ${o.gc?'gc':''} ${opt?'opt':(maxed&&o.lockNote?'lock':'')}">${ic(o.icon)}
