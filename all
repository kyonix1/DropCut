    <div class="buy"><button class="buyBtn ${opt?'opt':((!maxed&&o.can)?'':'off')}" ${o.attr}>
      <span class="q">LV ${fmt(o.lvl)}${o.cap<1e5?'/'+o.cap:''}</span>${maxed?(opt?'OPTIMAL':'MAX'):fmt(o.cost)}</button>${ad}</div></div>`;
