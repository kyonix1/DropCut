/* ---- skin effects -------------------------------------------------------
   Every skin uses the same round lamp; these are what set them apart:
     ember  rising sparks        orbit  motes circling like a planet's moons
     prism  rotating colour rays (a mirror ball)     eye  a blinking iris   */
function drawEmberFx(c,t,R){
  c.save(); c.globalCompositeOperation='lighter';
  for(let k=0;k<5;k++){
    const p=(t*.5+k*.2)%1, x=Math.sin(t*2+k*2.1)*10*(1-p*.5), y=-4-p*22, a=(1-p)*.8;
    const g=c.createRadialGradient(x,y,0,x,y,5*(1-p*.4));
    g.addColorStop(0,`rgba(255,${210-90*p|0},${120-80*p|0},${a})`);
    g.addColorStop(1,'rgba(255,90,20,0)');
    c.fillStyle=g; c.beginPath(); c.arc(x,y,5*(1-p*.4),0,6.283); c.fill(); }
  c.restore();
}
function drawOrbitFx(c,t,R,aura){
  for(let k=0;k<5;k++){
    const a=t*1.1+k*1.257, rr=R+Math.sin(t*1.6+k)*3;
    const x=Math.cos(a)*rr, y=Math.sin(a)*rr*.55;
    c.fillStyle=`rgba(${aura},${.3+.3*Math.sin(t*2+k)})`;
    c.beginPath(); c.arc(x,y,2.6,0,6.283); c.fill();
    c.fillStyle='rgba(18,4,36,.75)'; c.beginPath(); c.arc(x,y,1.3,0,6.283); c.fill(); }
  c.strokeStyle=`rgba(${aura},.25)`; c.lineWidth=1;
  c.beginPath(); c.ellipse(0,0,R,R*.55,0,0,6.283); c.stroke();
}
function drawPrismFx(c,t,R){
  c.save(); c.globalCompositeOperation='lighter';
  for(let k=0;k<6;k++){
    const a=t*.5+k*1.047, len=R+9+Math.sin(t*2+k)*3;
    c.strokeStyle=`hsla(${(t*40+k*60)%360},95%,65%,.45)`;
    c.lineWidth=2.6; c.lineCap='round';
    c.beginPath(); c.moveTo(Math.cos(a)*R*.8,Math.sin(a)*R*.8);
    c.lineTo(Math.cos(a)*len,Math.sin(a)*len); c.stroke(); }
  c.lineCap='butt'; c.restore();
}
function drawEyeFx(c,t,cx,cy,R,aura){
  const blink=Math.max(0,Math.sin(t*.7));
  c.fillStyle=`rgba(3,20,14,${.75*blink+.15})`;
  c.beginPath(); c.ellipse(cx,cy,R*.5,R*.5*blink+1,0,0,6.283); c.fill();
  c.fillStyle=`rgba(${aura},${.85*blink+.1})`;
  c.beginPath(); c.ellipse(cx,cy,R*.24,R*.24*blink+.6,0,0,6.283); c.fill();
  c.fillStyle='rgba(2,10,8,.95)';
  c.beginPath(); c.ellipse(cx,cy,R*.09,(R*.24*blink+.6)*.55,0,0,6.283); c.fill();
}

