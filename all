  addGlim(a);
  const px=auto?LAMP_SX+rand(-22,22):x, py=auto?LAMP_SY+rand(-22,22):y;
  pop(px,py,'+'+fmt(a),crit?'#ffd34d':'#d8fff6',crit);
  burst(px,py,crit?18:9,crit?'#ffd34d':'#9ffcf0',crit?270:190,.8,crit?1.3:1,true);
